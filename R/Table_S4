# ------------------------------------------------------------------------------
# 7. MAP EIA PRIME MOVER TO AN AVAILABLE CAMPD UNIT-TYPE LEVEL
# ------------------------------------------------------------------------------

find_unit_level <- function(levels_available, patterns, fallback) {
  for (pattern in patterns) {
    hit <- grep(
      pattern,
      levels_available,
      value = TRUE,
      ignore.case = TRUE,
      perl = TRUE
    )
    if (length(hit) > 0L) return(hit[1L])
  }
  fallback
}

modal_unit_type_by_fuel <- function(model_data) {
  counts <- as.data.table(model_data)[
    ,
    .N,
    by = .(
      convert_fuel = as.character(convert_fuel),
      Unit.Type = as.character(Unit.Type)
    )
  ]
  setorder(counts, convert_fuel, -N, Unit.Type)
  counts[, .SD[1L], by = convert_fuel]
}

historical_unit_mapping <- function(
  prime_mover,
  fuel,
  levels_available,
  model_data
) {
  modal_by_fuel <- modal_unit_type_by_fuel(model_data)
  overall_counts <- as.data.table(model_data)[
    ,
    .N,
    by = .(Unit.Type = as.character(Unit.Type))
  ][order(-N, Unit.Type)]
  overall_modal <- overall_counts$Unit.Type[1L]

  combustion_level <- find_unit_level(
    levels_available,
    c("^Combustion turbine$", "combustion.?turbine", "gas.?turbine"),
    overall_modal
  )
  combined_cycle_level <- find_unit_level(
    levels_available,
    c("combined.?cycle"),
    combustion_level
  )
  internal_combustion_level <- find_unit_level(
    levels_available,
    c("internal.?combust", "reciprocat"),
    overall_modal
  )

  code <- toupper(trimws(as.character(prime_mover)))
  fuel <- as.character(fuel)
  mapped <- rep(NA_character_, length(code))
  method <- rep("fuel-specific modern modal unit type", length(code))

  for (fuel_value in unique(fuel)) {
    rows <- which(fuel == fuel_value)
    modal_hit <- modal_by_fuel[
      convert_fuel == fuel_value,
      Unit.Type
    ]
    mapped[rows] <- if (length(modal_hit) > 0L) {
      modal_hit[1L]
    } else {
      overall_modal
    }
  }

  # ST identifies steam generation but not a CAMPD boiler firing design.
  # Retain the fuel-specific modal imputation rather than inventing a subtype.
  method[code %in% c("ST")] <- "ST; fuel-specific modern modal unit type"
  mapped[code %in% c("GT")] <- combustion_level
  method[code %in% c("GT")] <- "direct GT mapping"
  mapped[code %in% c("CT")] <- combustion_level
  method[code %in% c("CT")] <- "direct CT mapping"
  mapped[code %in% c("CA", "CS", "CC")] <- combined_cycle_level
  method[code %in% c("CA", "CS", "CC")] <- "direct combined-cycle mapping"
  mapped[code %in% c("IC")] <- internal_combustion_level
  method[code %in% c("IC")] <- "direct IC mapping"

  combined_rows <- grepl("combined", code, ignore.case = TRUE)
  mapped[combined_rows] <- combined_cycle_level
  method[combined_rows] <- "technology-text combined-cycle mapping"

  turbine_rows <- grepl(
    "combustion|gas.?turbine",
    code,
    ignore.case = TRUE
  ) & !combined_rows
  mapped[turbine_rows] <- combustion_level
  method[turbine_rows] <- "technology-text combustion-turbine mapping"

  internal_rows <- grepl("internal|reciprocat", code, ignore.case = TRUE)
  mapped[internal_rows] <- internal_combustion_level
  method[internal_rows] <- "technology-text internal-combustion mapping"

  data.table(Unit.Type = mapped, mapping_method = method)
}

