normalize_name <- function(x) {
  tolower(gsub("[^a-z0-9]", "", x))
}

pick_column <- function(
  column_names,
  candidates,
  label,
  required = TRUE
) {
  normalized_names <- normalize_name(column_names)
  normalized_candidates <- normalize_name(candidates)
  hit_position <- match(normalized_candidates, normalized_names)
  hit_position <- hit_position[!is.na(hit_position)]

  if (length(hit_position) == 0L) {
    if (required) {
      related <- grep(
        paste(c("facility", "oris", "plant", "unit"), collapse = "|"),
        column_names,
        value = TRUE,
        ignore.case = TRUE
      )
      stop(
        "Could not identify ", label, ".\n",
        "Candidate columns in the data were:\n  ",
        paste(related, collapse = "\n  ")
      )
    }
    return(NA_character_)
  }

  column_names[hit_position[1L]]
}

column_or_default <- function(
  dt,
  candidates,
  default = NA,
  required = FALSE,
  label = "column"
) {
  hit <- pick_column(names(dt), candidates, label, required = required)
  if (is.na(hit)) {
    return(rep(default, nrow(dt)))
  }
  dt[[hit]]
}

first_nonmissing <- function(x) {
  x <- x[!is.na(x) & nzchar(trimws(as.character(x)))]
  if (length(x) == 0L) NA_character_ else as.character(x[1L])
}

weighted_mean_available <- function(x, w) {
  keep <- is.finite(x) & is.finite(w) & w > 0
  if (!any(keep)) return(NA_real_)
  stats::weighted.mean(x[keep], w[keep])
}

predictive_metrics <- function(observed, predicted) {
  keep <- is.finite(observed) & is.finite(predicted)
  observed <- observed[keep]
  predicted <- predicted[keep]

  if (length(observed) < 2L) {
    stop("Fewer than two finite holdout predictions were available.")
  }

  denominator <- sum((observed - mean(observed))^2)
  predictive_r2 <- if (denominator > 0) {
    1 - sum((observed - predicted)^2) / denominator
  } else {
    NA_real_
  }

  data.table(
    n = length(observed),
    MAE_g_per_kWh = mean(abs(predicted - observed)),
    RMSE_g_per_kWh = sqrt(mean((predicted - observed)^2)),
    predictive_R2 = predictive_r2,
    mean_bias_g_per_kWh = mean(predicted - observed)
  )
}

align_matrix <- function(matrix_to_align, target_columns) {
  missing_columns <- setdiff(target_columns, colnames(matrix_to_align))
  if (length(missing_columns) > 0L) {
    zeros <- matrix(
      0,
      nrow = nrow(matrix_to_align),
      ncol = length(missing_columns),
      dimnames = list(NULL, missing_columns)
    )
    matrix_to_align <- cbind(matrix_to_align, zeros)
  }

  extra_columns <- setdiff(colnames(matrix_to_align), target_columns)
  if (length(extra_columns) > 0L) {
    matrix_to_align <- matrix_to_align[
      ,
      setdiff(colnames(matrix_to_align), extra_columns),
      drop = FALSE
    ]
  }

  matrix_to_align[, target_columns, drop = FALSE]
}

get_xgb_callback_result <- function(model, result_name) {
  # XGBoost 3.x stores callback results (including evaluation_log and
  # early_stop) as R attributes on the xgb.Booster object. Older releases
  # exposed some of them as list elements. Check both representations.
  result <- attr(model, result_name, exact = TRUE)
  if (!is.null(result)) {
    return(result)
  }

  tryCatch(
    model[[result_name]],
    error = function(e) NULL
  )
}

get_xgb_evaluation_log <- function(model) {
  evaluation_log <- get_xgb_callback_result(model, "evaluation_log")
  if (is.null(evaluation_log) || length(evaluation_log) == 0L) {
    stop(
      "XGBoost did not return an evaluation log even though validation data ",
      "were supplied. Installed XGBoost version: ",
      as.character(utils::packageVersion("xgboost"))
    )
  }

  evaluation_log <- data.table::as.data.table(evaluation_log)
  if (nrow(evaluation_log) == 0L || ncol(evaluation_log) == 0L) {
    stop(
      "XGBoost returned an empty evaluation log. Installed XGBoost version: ",
      as.character(utils::packageVersion("xgboost"))
    )
  }
  evaluation_log
}

validation_rmse_column <- function(
  evaluation_log,
  validation_name = "validation"
) {
  log_names <- names(evaluation_log)
  normalized_names <- normalize_name(log_names)
  preferred_names <- normalize_name(c(
    paste0(validation_name, "_rmse"),
    "validation_rmse",
    "valid_rmse",
    "test_rmse"
  ))

  preferred_position <- match(preferred_names, normalized_names)
  preferred_position <- preferred_position[!is.na(preferred_position)]
  if (length(preferred_position) > 0L) {
    return(log_names[preferred_position[1L]])
  }

  # Compatibility fallback for XGBoost releases that alter separators or
  # evaluation-set prefixes.
  candidate_position <- which(
    grepl("rmse$", normalized_names) &
      !grepl("train", normalized_names)
  )
  if (length(candidate_position) == 1L) {
    return(log_names[candidate_position])
  }

  stop(
    "Could not identify validation RMSE in the XGBoost evaluation log.\n",
    "Available evaluation-log columns were:\n  ",
    paste(log_names, collapse = "\n  ")
  )
}

early_stopping_result_from_model <- function(
  model,
  validation_name = "validation"
) {
  evaluation_log <- get_xgb_evaluation_log(model)
  metric_column <- validation_rmse_column(
    evaluation_log,
    validation_name
  )
  metric_values <- suppressWarnings(
    as.numeric(evaluation_log[[metric_column]])
  )
  if (!any(is.finite(metric_values))) {
    stop(
      "The validation RMSE column contained no finite values: ",
      metric_column
    )
  }

  best_iteration <- which.min(metric_values)

  list(
    best_iteration = as.integer(best_iteration),
    best_validation_rmse = metric_values[best_iteration],
    metric_column = metric_column
  )
}

