prepare_historical_base <- function(capacity_factor) {
  common_fuels <- intersect(
    so2_model_result$fuel_levels,
    nox_model_result$fuel_levels
  )
  common_fuels <- intersect(
    common_fuels,
    c("Coal", "Gas", "Oil", "Biomass")
  )

  yearly <- vector("list", length(TARGET_YEARS))
  names(yearly) <- as.character(TARGET_YEARS)

  for (year in TARGET_YEARS) {
    selected <- historical_generators[
      Operating_Year <= year &
        (is.na(Retirement_Year) | Retirement_Year > year) &
        convert_fuel %in% common_fuels
    ]

    if (nrow(selected) == 0L) {
      warning("No historical combustion generators found for ", year)
      next
    }

    selected <- copy(selected)
    selected[, Year := as.integer(year)]
    selected[, capacity_factor := capacity_factor]
    selected[
      ,
      annual_gen_kWh :=
        max_capacity_MW * 1000 * 8760 * capacity_factor
    ]
    selected[, log_Gen_kWh := log10(annual_gen_kWh + 1)]
    yearly[[as.character(year)]] <- selected
  }

  combined <- rbindlist(yearly, use.names = TRUE, fill = TRUE)
  if (nrow(combined) == 0L) {
    stop("Historical prediction table is empty.")
  }
  combined[, historical_row_id := .I]
  combined
}

predict_historical_pollutant <- function(base, model_result) {
  prediction_data <- copy(base)
  prediction_data[, convert_fuel := factor(
    convert_fuel,
    levels = model_result$fuel_levels
  )]
  unit_mapping <- historical_unit_mapping(
    prediction_data$Prime_Mover,
    as.character(prediction_data$convert_fuel),
    model_result$unit_levels,
    model_result$data
  )
  prediction_data[, Unit.Type := unit_mapping$Unit.Type]
  prediction_data[, unit_type_mapping_method := unit_mapping$mapping_method]
  prediction_data[, Unit.Type := factor(
    Unit.Type,
    levels = model_result$unit_levels
  )]

  for (control_column in model_result$controls) {
    prediction_data[, (control_column) := 0L]
  }

  raw_matrix <- stats::model.matrix(
    model_result$formula,
    data = prediction_data
  )
  prediction_matrix <- align_matrix(
    raw_matrix,
    model_result$design_columns
  )

  prediction_log <- predict(
    model_result$full_model,
    xgb.DMatrix(prediction_matrix)
  )
  prediction_ef <- pmax(0, 10^prediction_log - 1)

  pollutant_label <- ifelse(
    model_result$pollutant == "NOX",
    "NOx",
    "SO2"
  )
  result <- data.table(
    historical_row_id = prediction_data$historical_row_id,
    mapped_Unit_Type = as.character(prediction_data$Unit.Type),
    unit_type_mapping_method = prediction_data$unit_type_mapping_method,
    predicted_log10_EF = prediction_log,
    predicted_EF_g_per_kWh = prediction_ef,
    emissions_tons = (
      prediction_ef * prediction_data$annual_gen_kWh
    ) / GRAMS_PER_SHORT_TON
  )
  setnames(
    result,
    c(
      "mapped_Unit_Type",
      "unit_type_mapping_method",
      "predicted_log10_EF",
      "predicted_EF_g_per_kWh",
      "emissions_tons"
    ),
    paste0(
      c(
        "mapped_Unit_Type_",
        "unit_type_mapping_method_",
        "predicted_log10_EF_",
        "predicted_EF_g_per_kWh_",
        "emissions_tons_"
      ),
      pollutant_label
    )
  )
  result
}

run_historical_prediction <- function(capacity_factor) {
  base <- prepare_historical_base(capacity_factor)
  so2_prediction <- predict_historical_pollutant(
    base,
    so2_model_result
  )
  nox_prediction <- predict_historical_pollutant(
    base,
    nox_model_result
  )

  result <- merge(
    base,
    so2_prediction,
    by = "historical_row_id",
    all.x = TRUE
  )
  result <- merge(
    result,
    nox_prediction,
    by = "historical_row_id",
    all.x = TRUE
  )
  setorder(result, Year, Plant_ID, Generator_ID)
  result
}

