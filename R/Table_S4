fuel_category <- function(x) {
  x <- as.character(x)
  answer <- rep("Other", length(x))
  answer[grepl("coal", x, ignore.case = TRUE)] <- "Coal"
  answer[grepl("gas", x, ignore.case = TRUE)] <- "Gas"
  answer[
    grepl("oil|diesel|petroleum", x, ignore.case = TRUE)
  ] <- "Oil"
  answer[grepl("wood|biomass", x, ignore.case = TRUE)] <- "Biomass"
  answer
}

flag_pattern <- function(x, pattern) {
  as.integer(
    !is.na(x) &
      grepl(pattern, x, ignore.case = TRUE, perl = TRUE)
  )
}

prepare_pollutant_data <- function(pollutant) {
  pollutant <- toupper(pollutant)
  if (!pollutant %in% c("SO2", "NOX")) {
    stop("pollutant must be SO2 or NOX")
  }

  dt <- data.table::copy(campd_all)
  operation_date <- as.Date(dt[["Commercial.Operation.Date"]])
  gross_generation_kwh <- as.numeric(dt[["Gross.Load..MWh."]]) * 1000

  if (pollutant == "SO2") {
    mass_tons <- as.numeric(dt[["SO2.Mass..short.tons."]])
    controls_text <- as.character(dt[["SO2.Controls"]])
    control_columns <- c("SO2_FGD", "SO2_SDA", "SO2_DSI")
  } else {
    mass_tons <- as.numeric(dt[["NOx.Mass..short.tons."]])
    controls_text <- as.character(dt[["NOx.Controls"]])
    control_columns <- c("NOx_SCR", "NOx_SNCR", "NOx_LNB", "NOx_OFA")
  }

  mass_grams <- mass_tons * GRAMS_PER_SHORT_TON
  ef <- mass_grams / gross_generation_kwh

  model_dt <- data.table(
    facility_id = as.character(dt[[facility_id_column]]),
    convert_fuel = fuel_category(dt[["Primary.Fuel.Type"]]),
    Unit.Type = trimws(
      gsub("\\s*\\(.*?\\)", "", as.character(dt[["Unit.Type"]]))
    ),
    Year = as.integer(dt[["Year"]]),
    gross_generation_kWh = gross_generation_kwh,
    log_Gen_kWh = log10(gross_generation_kwh + 1),
    EF = ef,
    log_EF = log10(ef + 1),
    operation_date = operation_date
  )

  if (pollutant == "SO2") {
    # FGD is intentionally broad; SDA and DSI remain separate indicators.
    model_dt[, SO2_FGD := flag_pattern(
      controls_text,
      "scrubber|flue.?gas.?desul|\\bFGD\\b"
    )]
    model_dt[, SO2_SDA := flag_pattern(
      controls_text,
      "spray.?dryer|spray.?dry|\\bSDA\\b"
    )]
    model_dt[, SO2_DSI := flag_pattern(
      controls_text,
      "dry.?sorbent|\\bDSI\\b"
    )]
  } else {
    model_dt[, NOx_SCR := flag_pattern(
      controls_text,
      "selective.?catalytic|\\bSCR\\b"
    )]
    model_dt[, NOx_SNCR := flag_pattern(
      controls_text,
      "selective.?non.?catalytic|\\bSNCR\\b"
    )]
    model_dt[, NOx_LNB := flag_pattern(
      controls_text,
      "low.?NOx|low.?nitrogen|\\bLNB\\b"
    )]
    model_dt[, NOx_OFA := flag_pattern(
      controls_text,
      "over.?fire.?air|\\bOFA\\b"
    )]
  }

  n_before <- nrow(model_dt)

  model_dt <- model_dt[
    !is.na(operation_date) &
      operation_date > as.Date("1939-12-31") &
      !is.na(facility_id) &
      nzchar(facility_id) &
      !is.na(Unit.Type) &
      nzchar(Unit.Type) &
      is.finite(Year) &
      Year >= 1995L &
      Year <= 2020L &
      is.finite(gross_generation_kWh) &
      gross_generation_kWh > 0 &
      is.finite(EF) &
      EF >= 0 &
      EF < MAX_EF_G_PER_KWH &
      is.finite(log_EF)
  ]

  if (nrow(model_dt) == 0L) {
    stop("No usable ", pollutant, " records remained after cleaning.")
  }

  fuel_levels <- sort(unique(model_dt$convert_fuel))
  unit_levels <- sort(unique(model_dt$Unit.Type))
  model_dt[, convert_fuel := factor(convert_fuel, levels = fuel_levels)]
  model_dt[, Unit.Type := factor(Unit.Type, levels = unit_levels)]

  control_counts <- model_dt[
    ,
    lapply(.SD, sum, na.rm = TRUE),
    .SDcols = control_columns
  ]
  active_control_columns <- control_columns[
    vapply(
      control_columns,
      function(column_name) {
        sum(model_dt[[column_name]], na.rm = TRUE) > 0
      },
      logical(1)
    )
  ]
  inactive_control_columns <- setdiff(
    control_columns,
    active_control_columns
  )
  if (length(inactive_control_columns) > 0L) {
    warning(
      pollutant,
      " control predictor(s) had zero positive records and were excluded: ",
      paste(inactive_control_columns, collapse = ", ")
    )
  }

  qa <- data.table(
    pollutant = pollutant,
    merged_records = nrow(campd_all),
    records_before_cleaning = n_before,
    records_after_cleaning = nrow(model_dt),
    records_removed = n_before - nrow(model_dt),
    facilities_after_cleaning = uniqueN(model_dt$facility_id),
    fuel_levels = paste(fuel_levels, collapse = " | "),
    unit_type_levels = length(unit_levels),
    facility_id_column = facility_id_column,
    max_EF_filter_g_per_kWh = MAX_EF_G_PER_KWH
  )

  list(
    pollutant = pollutant,
    data = model_dt,
    controls = active_control_columns,
    inactive_controls = inactive_control_columns,
    control_counts = control_counts,
    fuel_levels = fuel_levels,
    unit_levels = unit_levels,
    qa = qa
  )
}

