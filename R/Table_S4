map_eia_fuel <- function(code) {
  code <- toupper(trimws(as.character(code)))
  answer <- rep("Unknown", length(code))
  answer[code %in% c("BIT", "SUB", "LIG", "RC", "WC", "ANT")] <- "Coal"
  answer[code %in% c("DFO", "RFO", "JF", "KER", "PC", "WO")] <- "Oil"
  answer[
    code %in% c("NG", "OG", "PG", "BFG", "SGC", "SGP", "LFG")
  ] <- "Gas"
  answer[
    code %in% c(
      "BLQ", "WDS", "WDL", "OBS", "OBL", "OBG", "AB",
      "MSW", "TDF", "SLW", "PUR"
    )
  ] <- "Biomass"
  answer[
    code %in% c("WAT", "WND", "SUN", "GEO", "NUC", "WH")
  ] <- "Renewable"
  answer
}

standardize_generator_table <- function(dt, is_active) {
  data.table::setDT(dt)
  n <- nrow(dt)
  prime_mover_candidates <- c(
    "PRIME_MOVER",
    "Prime Mover",
    "Prime.Mover",
    "Technology",
    "Unit Type"
  )
  prime_mover_column <- pick_column(
    names(dt),
    prime_mover_candidates,
    "historical prime mover or technology",
    required = FALSE
  )
  prime_mover_value <- if (is.na(prime_mover_column)) {
    rep(NA_character_, n)
  } else {
    as.character(dt[[prime_mover_column]])
  }

  retirement_year <- if (is_active) {
    rep(NA_integer_, n)
  } else {
    as.integer(column_or_default(
      dt,
      c("RETIREMENT_YEAR", "Retirement Year", "Retirement.Year"),
      default = NA_integer_
    ))
  }

  data.table(
    Entity_ID = as.character(column_or_default(
      dt,
      c("UTILITY_ID", "Entity ID", "Entity.ID")
    )),
    Plant_ID = as.character(column_or_default(
      dt,
      c("PLANT_CODE", "Plant ID", "Plant.ID"),
      required = TRUE,
      label = "historical Plant ID"
    )),
    Plant_Name = as.character(column_or_default(
      dt,
      c("PLANT_NAME", "Plant Name", "Plant.Name")
    )),
    Plant_State = as.character(column_or_default(
      dt,
      c("STATE", "Plant State", "Plant.State")
    )),
    County = as.character(column_or_default(
      dt,
      c("COUNTY", "County")
    )),
    Generator_ID = as.character(column_or_default(
      dt,
      c("GENERATOR_ID", "Generator ID", "Generator.ID")
    )),
    Prime_Mover = prime_mover_value,
    Prime_Mover_Source = if (is.na(prime_mover_column)) {
      NA_character_
    } else {
      prime_mover_column
    },
    max_capacity_MW = as.numeric(column_or_default(
      dt,
      c(
        "NAMEPLATE",
        "Nameplate Capacity (MW)",
        "Nameplate.Capacity..MW."
      ),
      required = TRUE,
      label = "historical nameplate capacity"
    )),
    Operating_Year = as.integer(column_or_default(
      dt,
      c("OPERATING_YEAR", "Operating Year", "Operating.Year"),
      required = TRUE,
      label = "historical operating year"
    )),
    Retirement_Year = retirement_year,
    Energy_Source_Code = as.character(column_or_default(
      dt,
      c(
        "ENERGY_SOURCE_1",
        "Energy Source Code",
        "Energy.Source.Code"
      ),
      required = TRUE,
      label = "historical energy-source code"
    )),
    Latitude = as.numeric(column_or_default(
      dt,
      c("Latitude", "LATITUDE", "Y")
    )),
    Longitude = as.numeric(column_or_default(
      dt,
      c("Longitude", "LONGITUDE", "X")
    ))
  )
}

read_historical_generators <- function(generator_file, location_file) {
  sheets <- readxl::excel_sheets(generator_file)

  if (all(c("Exist", "Ret_IP") %in% sheets)) {
    message("Reading 2010 EIA generator workbook: Exist + Ret_IP")
    active_raw <- as.data.table(readxl::read_excel(
      generator_file,
      sheet = "Exist"
    ))
    retired_raw <- as.data.table(readxl::read_excel(
      generator_file,
      sheet = "Ret_IP"
    ))
  } else {
    message(
      "Reading EIA generator workbook using legacy 2022 sheet layout: ",
      "sheet 1 + sheet 3, skip 2"
    )
    active_raw <- as.data.table(readxl::read_excel(
      generator_file,
      sheet = 1,
      skip = 2
    ))
    retired_raw <- as.data.table(readxl::read_excel(
      generator_file,
      sheet = 3,
      skip = 2
    ))
  }

  active <- standardize_generator_table(active_raw, is_active = TRUE)
  retired <- standardize_generator_table(retired_raw, is_active = FALSE)

  generators <- unique(
    rbindlist(list(active, retired), use.names = TRUE, fill = TRUE),
    by = c(
      "Plant_ID",
      "Generator_ID",
      "Operating_Year",
      "Retirement_Year",
      "Energy_Source_Code",
      "max_capacity_MW",
      "Prime_Mover",
      "Prime_Mover_Source"
    )
  )

  generators[, convert_fuel := map_eia_fuel(Energy_Source_Code)]
  generators <- generators[
    !is.na(Plant_ID) &
      nzchar(Plant_ID) &
      is.finite(Operating_Year) &
      is.finite(max_capacity_MW) &
      max_capacity_MW > 0
  ]

  if (!is.na(location_file) && file.exists(location_file)) {
    message("Joining historical longitude/latitude from: ", location_file)
    location_raw <- fread(location_file)
    location_fuel_raw <- as.character(column_or_default(
      location_raw,
      c("variable", "convert_fuel", "Fuel"),
      required = TRUE,
      label = "location-file fuel category"
    ))
    location_fuel <- rep("Unknown", length(location_fuel_raw))
    location_fuel[
      grepl("coal", location_fuel_raw, ignore.case = TRUE)
    ] <- "Coal"
    location_fuel[
      grepl("gas", location_fuel_raw, ignore.case = TRUE)
    ] <- "Gas"
    location_fuel[
      grepl("oil|petroleum|diesel", location_fuel_raw, ignore.case = TRUE)
    ] <- "Oil"
    location_fuel[
      grepl("wood|biomass", location_fuel_raw, ignore.case = TRUE)
    ] <- "Biomass"
    location_fuel[
      grepl("renew", location_fuel_raw, ignore.case = TRUE)
    ] <- "Renewable"

    location <- data.table(
      Plant_ID = as.character(column_or_default(
        location_raw,
        c("PLANT_CODE", "Plant ID", "Plant.ID"),
        required = TRUE,
        label = "location-file Plant ID"
      )),
      convert_fuel = location_fuel,
      Longitude_join = as.numeric(column_or_default(
        location_raw,
        c("X", "Longitude", "LONGITUDE"),
        required = TRUE,
        label = "location-file longitude"
      )),
      Latitude_join = as.numeric(column_or_default(
        location_raw,
        c("Y", "Latitude", "LATITUDE"),
        required = TRUE,
        label = "location-file latitude"
      ))
    )
    location <- location[
      ,
      .(
        Longitude_join = mean(Longitude_join, na.rm = TRUE),
        Latitude_join = mean(Latitude_join, na.rm = TRUE)
      ),
      by = .(Plant_ID, convert_fuel)
    ]
    location[
      !is.finite(Longitude_join),
      Longitude_join := NA_real_
    ]
    location[
      !is.finite(Latitude_join),
      Latitude_join := NA_real_
    ]

    location_by_plant <- location[
      ,
      .(
        Longitude_plant = mean(Longitude_join, na.rm = TRUE),
        Latitude_plant = mean(Latitude_join, na.rm = TRUE)
      ),
      by = Plant_ID
    ]
    location_by_plant[
      !is.finite(Longitude_plant),
      Longitude_plant := NA_real_
    ]
    location_by_plant[
      !is.finite(Latitude_plant),
      Latitude_plant := NA_real_
    ]

    generators <- merge(
      generators,
      location,
      by = c("Plant_ID", "convert_fuel"),
      all.x = TRUE
    )
    generators <- merge(
      generators,
      location_by_plant,
      by = "Plant_ID",
      all.x = TRUE
    )
    generators[
      is.na(Longitude) & !is.na(Longitude_join),
      Longitude := Longitude_join
    ]
    generators[
      is.na(Latitude) & !is.na(Latitude_join),
      Latitude := Latitude_join
    ]
    generators[
      is.na(Longitude) & !is.na(Longitude_plant),
      Longitude := Longitude_plant
    ]
    generators[
      is.na(Latitude) & !is.na(Latitude_plant),
      Latitude := Latitude_plant
    ]
    generators[
      ,
      c(
        "Longitude_join",
        "Latitude_join",
        "Longitude_plant",
        "Latitude_plant"
      ) := NULL
    ]
  }

  generators
}

