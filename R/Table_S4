make_facility_split <- function(facility_ids, development_fraction, seed) {
  facilities <- sort(unique(as.character(facility_ids)))
  if (length(facilities) < 10L) {
    stop("At least 10 facilities are required for a stable 80:20 split.")
  }

  set.seed(seed)
  shuffled <- sample(facilities, length(facilities), replace = FALSE)
  n_development <- floor(development_fraction * length(shuffled))
  n_development <- max(1L, min(n_development, length(shuffled) - 1L))

  list(
    development = shuffled[seq_len(n_development)],
    holdout = shuffled[(n_development + 1L):length(shuffled)]
  )
}

assign_facility_folds <- function(facility_ids, k, seed) {
  facilities <- sort(unique(as.character(facility_ids)))
  if (length(facilities) < k) {
    stop("Fewer development facilities than requested CV folds.")
  }

  set.seed(seed)
  shuffled <- sample(facilities, length(facilities), replace = FALSE)
  assigned <- data.table(
    facility_id = shuffled,
    fold = rep(seq_len(k), length.out = length(shuffled))
  )
  assigned
}

build_design_matrix <- function(dt, controls) {
  rhs <- paste(
    c("convert_fuel", "Unit.Type", "Year", "log_Gen_kWh", controls),
    collapse = " + "
  )
  formula_object <- stats::as.formula(paste("~", rhs, "- 1"))
  list(
    formula = formula_object,
    matrix = stats::model.matrix(formula_object, data = dt)
  )
}

run_pollutant_model <- function(prepared, seed_offset = 0L) {
  pollutant <- prepared$pollutant
  dt <- data.table::copy(prepared$data)
  controls <- prepared$controls

  message("\n============================================================")
  message("Running ", pollutant, " facility-grouped model")
  message("============================================================")

  split <- make_facility_split(
    dt$facility_id,
    DEVELOPMENT_FRACTION,
    SEED + seed_offset
  )
  dt[, partition := ifelse(
    facility_id %in% split$development,
    "development",
    "holdout"
  )]

  overlap <- intersect(split$development, split$holdout)
  if (length(overlap) > 0L) {
    stop("Facility leakage detected between development and holdout sets.")
  }

  fold_assignment <- assign_facility_folds(
    split$development,
    N_FOLDS,
    SEED + 100L + seed_offset
  )
  dt <- merge(dt, fold_assignment, by = "facility_id", all.x = TRUE)

  design <- build_design_matrix(dt, controls)
  X_all <- design$matrix
  y_all <- dt$log_EF
  development_rows <- which(dt$partition == "development")
  holdout_rows <- which(dt$partition == "holdout")

  if (length(holdout_rows) == 0L) {
    stop("No holdout rows were created for ", pollutant)
  }

  cv_results <- vector(
    "list",
    nrow(TUNING_GRID) * N_FOLDS
  )
  cv_counter <- 0L

  for (config_row in seq_len(nrow(TUNING_GRID))) {
    cfg <- TUNING_GRID[config_row]
    message(
      pollutant, " tuning config ", cfg$config_id,
      "/", nrow(TUNING_GRID),
      ": depth=", cfg$max_depth,
      ", eta=", cfg$eta,
      ", min_child_weight=", cfg$min_child_weight
    )

    params <- list(
      objective = "reg:squarederror",
      eval_metric = "rmse",
      max_depth = cfg$max_depth,
      eta = cfg$eta,
      min_child_weight = cfg$min_child_weight,
      gamma = cfg$gamma,
      subsample = cfg$subsample,
      colsample_bytree = cfg$colsample_bytree,
      lambda = cfg$lambda,
      alpha = cfg$alpha,
      nthread = NTHREAD,
      seed = SEED + config_row + seed_offset
    )

    for (fold_number in seq_len(N_FOLDS)) {
      validation_rows <- development_rows[
        dt$fold[development_rows] == fold_number
      ]
      training_rows <- development_rows[
        dt$fold[development_rows] != fold_number
      ]

      dtrain <- xgb.DMatrix(
        data = X_all[training_rows, , drop = FALSE],
        label = y_all[training_rows]
      )
      dvalid <- xgb.DMatrix(
        data = X_all[validation_rows, , drop = FALSE],
        label = y_all[validation_rows]
      )

      cv_model <- xgb.train(
        params = params,
        data = dtrain,
        nrounds = MAX_BOOSTING_ROUNDS,
        evals = list(training = dtrain, validation = dvalid),
        early_stopping_rounds = EARLY_STOPPING_PATIENCE,
        verbose = 0
      )

      early_stopping_result <- early_stopping_result_from_model(
        cv_model,
        "validation"
      )
      best_iteration <- early_stopping_result$best_iteration
      best_validation_rmse <-
        early_stopping_result$best_validation_rmse

      cv_counter <- cv_counter + 1L
      cv_results[[cv_counter]] <- data.table(
        pollutant = pollutant,
        config_id = cfg$config_id,
        fold = fold_number,
        development_training_facilities = uniqueN(
          dt$facility_id[training_rows]
        ),
        internal_validation_facilities = uniqueN(
          dt$facility_id[validation_rows]
        ),
        development_training_records = length(training_rows),
        internal_validation_records = length(validation_rows),
        best_iteration = best_iteration,
        best_validation_RMSE_log10 = best_validation_rmse,
        max_depth = cfg$max_depth,
        eta = cfg$eta,
        min_child_weight = cfg$min_child_weight,
        gamma = cfg$gamma,
        subsample = cfg$subsample,
        colsample_bytree = cfg$colsample_bytree,
        lambda = cfg$lambda,
        alpha = cfg$alpha
      )

      rm(cv_model, dtrain, dvalid)
      invisible(gc())
    }
  }

  cv_results <- rbindlist(cv_results[seq_len(cv_counter)], fill = TRUE)
  cv_summary <- cv_results[
    ,
    .(
      mean_validation_RMSE_log10 = mean(best_validation_RMSE_log10),
      sd_validation_RMSE_log10 = stats::sd(best_validation_RMSE_log10),
      median_best_iteration = as.integer(
        round(stats::median(best_iteration))
      ),
      min_best_iteration = min(best_iteration),
      max_best_iteration = max(best_iteration)
    ),
    by = .(
      pollutant,
      config_id,
      max_depth,
      eta,
      min_child_weight,
      gamma,
      subsample,
      colsample_bytree,
      lambda,
      alpha
    )
  ][order(mean_validation_RMSE_log10, config_id)]

  selected <- cv_summary[1L]
  selected_rounds <- max(1L, selected$median_best_iteration)
  message(
    pollutant, " selected config ", selected$config_id,
    " with ", selected_rounds, " boosting rounds."
  )

  selected_params <- list(
    objective = "reg:squarederror",
    eval_metric = "rmse",
    max_depth = selected$max_depth,
    eta = selected$eta,
    min_child_weight = selected$min_child_weight,
    gamma = selected$gamma,
    subsample = selected$subsample,
    colsample_bytree = selected$colsample_bytree,
    lambda = selected$lambda,
    alpha = selected$alpha,
    nthread = NTHREAD,
    seed = SEED + 1000L + seed_offset
  )

  # Final evaluation model: development facilities only.
  ddevelopment <- xgb.DMatrix(
    X_all[development_rows, , drop = FALSE],
    label = y_all[development_rows]
  )
  evaluation_model <- xgb.train(
    params = selected_params,
    data = ddevelopment,
    nrounds = selected_rounds,
    verbose = 0
  )

  dholdout <- xgb.DMatrix(
    X_all[holdout_rows, , drop = FALSE],
    label = y_all[holdout_rows]
  )
  holdout_prediction_log <- predict(evaluation_model, dholdout)

  # Correct inverse transformation for log10(EF + 1).
  observed_ef <- pmax(0, 10^y_all[holdout_rows] - 1)
  predicted_ef <- pmax(0, 10^holdout_prediction_log - 1)
  metrics <- predictive_metrics(observed_ef, predicted_ef)

  holdout_predictions <- data.table(
    pollutant = pollutant,
    facility_id = dt$facility_id[holdout_rows],
    Year = dt$Year[holdout_rows],
    convert_fuel = as.character(dt$convert_fuel[holdout_rows]),
    Unit.Type = as.character(dt$Unit.Type[holdout_rows]),
    observed_EF_g_per_kWh = observed_ef,
    predicted_EF_g_per_kWh = predicted_ef,
    residual_g_per_kWh = predicted_ef - observed_ef
  )

  # Refit on all modern facilities for historical prediction only.
  dall <- xgb.DMatrix(X_all, label = y_all)
  full_model <- xgb.train(
    params = selected_params,
    data = dall,
    nrounds = selected_rounds,
    verbose = 0
  )

  development_facilities <- uniqueN(dt$facility_id[development_rows])
  holdout_facilities <- uniqueN(dt$facility_id[holdout_rows])
  total_facilities <- uniqueN(dt$facility_id)

  model_summary <- data.table(
    pollutant = ifelse(pollutant == "NOX", "NOx", pollutant),
    total_facilities = total_facilities,
    total_records = nrow(dt),
    development_facilities = development_facilities,
    development_records = length(development_rows),
    holdout_facilities = holdout_facilities,
    holdout_records = length(holdout_rows),
    cv_folds = N_FOLDS,
    tuning_configurations = nrow(TUNING_GRID),
    selected_config_id = selected$config_id,
    max_depth = selected$max_depth,
    eta = selected$eta,
    min_child_weight = selected$min_child_weight,
    gamma = selected$gamma,
    subsample = selected$subsample,
    colsample_bytree = selected$colsample_bytree,
    lambda = selected$lambda,
    alpha = selected$alpha,
    selected_boosting_rounds = selected_rounds,
    early_stopping_patience = EARLY_STOPPING_PATIENCE,
    selection_RMSE_log10 = selected$mean_validation_RMSE_log10,
    MAE_g_per_kWh = metrics$MAE_g_per_kWh,
    RMSE_g_per_kWh = metrics$RMSE_g_per_kWh,
    predictive_R2 = metrics$predictive_R2,
    mean_bias_g_per_kWh = metrics$mean_bias_g_per_kWh,
    response = "log10(EF + 1)",
    back_transformation = "10^predicted_log_EF - 1",
    control_predictors = paste(controls, collapse = " | ")
  )

  message(
    pollutant,
    " independent holdout: MAE=",
    format(metrics$MAE_g_per_kWh, digits = 5),
    ", RMSE=",
    format(metrics$RMSE_g_per_kWh, digits = 5),
    ", predictive R2=",
    format(metrics$predictive_R2, digits = 5),
    ", mean bias=",
    format(metrics$mean_bias_g_per_kWh, digits = 5)
  )

  list(
    pollutant = pollutant,
    prepared = prepared,
    data = dt,
    formula = design$formula,
    design_columns = colnames(X_all),
    cv_results = cv_results,
    cv_summary = cv_summary,
    model_summary = model_summary,
    holdout_predictions = holdout_predictions,
    evaluation_model = evaluation_model,
    full_model = full_model,
    fuel_levels = prepared$fuel_levels,
    unit_levels = prepared$unit_levels,
    controls = controls,
    selected_rounds = selected_rounds
  )
}

