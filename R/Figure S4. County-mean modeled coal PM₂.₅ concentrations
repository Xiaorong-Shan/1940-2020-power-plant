#!/usr/bin/env Rscript

# ======================================================================
# Figure S4. County-level coal-attributable PM2.5, 1940-1990
# Complete Hopper-safe revision
#
# Input:
#   county_pm25_pop_all_years.csv
#
# Output:
#   Figure_S4_county_coal_PM25_maps.pdf
#   Figure_S4_county_coal_PM25_maps.png
#
# Run on Hopper:
#   Rscript Figure_S4_hopper_revised.R
# ======================================================================

rm(list = ls(all.names = TRUE))
graphics.off()

suppressPackageStartupMessages({
  library(data.table)
  library(sf)
  library(USAboundaries)
})

# ----------------------------------------------------------------------
# 1. Paths and settings
# ----------------------------------------------------------------------

root <- paste0(
  "/scratch/xshan2/R_Code/disperseR/main/output/",
  "pm25_decades_model.lm.cv_single_poly_proxy1999met"
)

input_file <- file.path(
  root,
  "pwe_outputs_decades_FULL_FINAL_hopperSafe",
  "county_pm25_pop_all_years.csv"
)

output_dir <- file.path(root, "figures_revised")
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)

pdf_file <- file.path(
  output_dir,
  "Figure_S4_county_coal_PM25_maps.pdf"
)

png_file <- file.path(
  output_dir,
  "Figure_S4_county_coal_PM25_maps.png"
)

temporary_pdf <- file.path(
  output_dir,
  "Figure_S4_RENDERING_TEMP.pdf"
)

years_to_plot <- c(1940, 1950, 1960, 1970, 1980, 1990)
color_cap <- 0.5

unlink(c(pdf_file, png_file, temporary_pdf))

if (!file.exists(input_file)) {
  stop("Input file not found:\n", input_file)
}

# ----------------------------------------------------------------------
# 2. Read and check the county data
# ----------------------------------------------------------------------

format_fips <- function(x) {
  x <- sub("\\.0+$", "", trimws(as.character(x)))
  x <- gsub("[^0-9]", "", x)
  x <- suppressWarnings(as.integer(x))
  ifelse(is.na(x), NA_character_, sprintf("%05d", x))
}

county_data <- fread(
  input_file,
  select = c("year", "geoid", "pm25")
)

county_data[, year := suppressWarnings(as.integer(year))]
county_data[, geoid := format_fips(geoid)]
county_data[, pm25 := suppressWarnings(as.numeric(pm25))]

county_data <- county_data[
  year %in% years_to_plot &
    !is.na(geoid) &
    is.finite(pm25) &
    pm25 >= 0
]

county_data <- county_data[
  ,
  .(pm25 = mean(pm25, na.rm = TRUE)),
  by = .(year, geoid)
]

if (nrow(county_data) < 18000) {
  stop(
    "Too few usable county-year rows: ",
    nrow(county_data),
    ". Expected approximately six years of U.S. counties."
  )
}

if (max(county_data$pm25, na.rm = TRUE) <= 0) {
  stop("All county PM2.5 values are zero.")
}

# ----------------------------------------------------------------------
# 3. Prepare contiguous-U.S. county and state geometry
# ----------------------------------------------------------------------

counties <- USAboundaries::us_counties()
states <- USAboundaries::us_states()

county_fips_column <- intersect(
  c("geoid", "fips", "county_fips", "geoid10"),
  names(counties)
)[1]

state_name_column <- intersect(
  c("name", "state_name"),
  names(states)
)[1]

if (is.na(county_fips_column) || is.na(state_name_column)) {
  stop("Required geometry identifier columns were not found.")
}

counties$geoid_join <- format_fips(counties[[county_fips_column]])

# Exclude Alaska, Hawaii, and Puerto Rico.
counties <- counties[
  !substr(counties$geoid_join, 1, 2) %in% c("02", "15", "72"),
]

states <- states[
  !states[[state_name_column]] %in% c("Alaska", "Hawaii", "Puerto Rico"),
]

albers_crs <- paste(
  "+proj=aea +lat_1=29.5 +lat_2=45.5 +lat_0=23",
  "+lon_0=-96 +datum=NAD83 +units=m +no_defs"
)

counties <- st_transform(counties, albers_crs)
states <- st_transform(states, albers_crs)

if (nrow(counties) < 3000) {
  stop("Too few contiguous-U.S. county geometries: ", nrow(counties))
}

# ----------------------------------------------------------------------
# 4. Join one complete county map for each decade
# ----------------------------------------------------------------------

map_panels <- lapply(years_to_plot, function(selected_year) {
  values <- county_data[
    year == selected_year,
    .(geoid, pm25)
  ]

  joined <- counties
  matched_row <- match(joined$geoid_join, values$geoid)
  joined$plot_pm25 <- values$pm25[matched_row]

  # The source table is expected to cover all counties. A missing join is
  # displayed as zero and reported below so that it is not silently hidden.
  joined$plot_pm25[is.na(joined$plot_pm25)] <- 0
  joined
})

panel_maxima <- vapply(
  map_panels,
  function(x) max(x$plot_pm25, na.rm = TRUE),
  numeric(1)
)

panel_missing <- vapply(
  years_to_plot,
  function(selected_year) {
    sum(!counties$geoid_join %in% county_data[year == selected_year, geoid])
  },
  integer(1)
)

if (all(panel_maxima <= 0)) {
  stop("All six map panels are zero.")
}

message("Input: ", input_file)
message("Usable county-year rows: ", nrow(county_data))
message("Counties per panel: ", nrow(counties))
message(
  "Panel maxima: ",
  paste(
    paste0(years_to_plot, "=", format(round(panel_maxima, 3), nsmall = 3)),
    collapse = "; "
  )
)
message(
  "Unmatched counties set to zero: ",
  paste(
    paste0(years_to_plot, "=", panel_missing),
    collapse = "; "
  )
)

# ----------------------------------------------------------------------
# 5. Shared color scale
# ----------------------------------------------------------------------

# The same 0-0.5 microgram/m3 linear scale is used for all six years.
# Values at or above 0.5 receive the darkest red.
palette_colors <- colorRampPalette(
  c(
    "#FFF7EC",
    "#FDD49E",
    "#FC8D59",
    "#E34A33",
    "#B30000",
    "#67000D"
  )
)(256)

pm25_colors <- function(x) {
  x <- pmax(0, pmin(x, color_cap))
  color_index <- floor(x / color_cap * 255) + 1
  color_index[!is.finite(color_index)] <- 1
  palette_colors[color_index]
}

# ----------------------------------------------------------------------
# 6. Draw the six maps and one common legend
# ----------------------------------------------------------------------

draw_figure_s4 <- function() {
  layout(
    matrix(
      c(
        1, 2, 3,
        4, 5, 6,
        7, 7, 7
      ),
      nrow = 3,
      byrow = TRUE
    ),
    heights = c(1, 1, 0.27)
  )

  for (i in seq_along(years_to_plot)) {
    par(
      mar = c(0.05, 0.05, 1.20, 0.05),
      xaxs = "i",
      yaxs = "i"
    )

    plot(
      st_geometry(map_panels[[i]]),
      col = pm25_colors(map_panels[[i]]$plot_pm25),
      border = "grey82",
      lwd = 0.07,
      axes = FALSE,
      asp = 1
    )

    plot(
      st_geometry(states),
      add = TRUE,
      col = NA,
      border = "grey35",
      lwd = 0.45
    )

    title(
      main = as.character(years_to_plot[i]),
      font.main = 2,
      cex.main = 1.08,
      line = 0.18
    )
  }

  # Shared horizontal color bar.
  par(
    mar = c(1.50, 5.15, 1.15, 5.15),
    xaxs = "i",
    yaxs = "i",
    xpd = NA
  )

  color_values <- seq(0, color_cap, length.out = 256)

  image(
    x = color_values,
    y = c(0, 1),
    z = matrix(rep(color_values, 2), nrow = 256, ncol = 2),
    col = palette_colors,
    axes = FALSE,
    xlab = "",
    ylab = "",
    useRaster = TRUE
  )

  legend_breaks <- seq(0, color_cap, by = 0.1)

  # Every label is drawn in one axis call. The last label uses plotmath,
  # so Hopper does not need a PDF font containing the Unicode >= glyph.
  legend_labels <- expression(
    "0",
    "0.1",
    "0.2",
    "0.3",
    "0.4",
    phantom(.) >= 0.5
  )

  axis(
    side = 1,
    at = legend_breaks,
    labels = legend_labels,
    cex.axis = 0.84,
    font.axis = 1,
    mgp = c(2.2, 0.37, 0),
    tck = -0.20,
    lwd = 0.5,
    lwd.ticks = 0.5
  )

  box(col = "grey35", lwd = 0.5)

  mtext(
    expression(
      "Coal-attributable PM"[2.5]~"("*mu*"g "*m^{-3}*")"
    ),
    side = 3,
    line = 0.08,
    cex = 0.90,
    font = 2
  )
}

# ----------------------------------------------------------------------
# 7. Save a validated PDF, then convert it to a 600-dpi PNG
# ----------------------------------------------------------------------

pdf(
  temporary_pdf,
  width = 7.4,
  height = 5.65,
  onefile = TRUE,
  useDingbats = FALSE,
  paper = "special",
  bg = "white"
)

drawing_error <- tryCatch(
  {
    draw_figure_s4()
    NULL
  },
  error = function(e) e
)

invisible(dev.off())

if (!is.null(drawing_error)) {
  unlink(temporary_pdf)
  stop("Figure drawing stopped: ", conditionMessage(drawing_error))
}

if (
  !file.exists(temporary_pdf) ||
    is.na(file.info(temporary_pdf)$size) ||
    file.info(temporary_pdf)$size < 10000
) {
  unlink(temporary_pdf)
  stop("The temporary PDF failed validation.")
}

if (!file.rename(temporary_pdf, pdf_file)) {
  stop("The completed PDF could not be moved to its final filename.")
}

pdf_converter <- Sys.which("pdftoppm")
png_saved <- FALSE

if (nzchar(pdf_converter)) {
  png_prefix <- sub("\\.png$", "", png_file)

  conversion_status <- system2(
    pdf_converter,
    c(
      "-png",
      "-r", "600",
      "-singlefile",
      shQuote(pdf_file),
      shQuote(png_prefix)
    )
  )

  Sys.sleep(1)

  png_saved <- (
    conversion_status == 0 &&
      file.exists(png_file) &&
      !is.na(file.info(png_file)$size) &&
      file.info(png_file)$size > 10000
  )
} else {
  warning(
    "pdftoppm was not found. The PDF was created, but the PNG was not."
  )
}

message("Figure S4 PDF saved: ", file.exists(pdf_file))
message("PDF: ", pdf_file)
message("Figure S4 PNG saved: ", png_saved)
message("PNG: ", png_file)
