#!/usr/bin/env Rscript

# ==============================================================================
# Figure 2
# Historical U.S. fossil-fuel power-plant SO2 and NOx emissions, 1940-1990
#
# Panel (a): National totals from the EPA inventory, the corrected
#            facility-level model output, and the AP-42 benchmark.
# Panel (b): Fuel-specific facility-level and AP-42 estimates.
#
# The facility-level series is read directly from the final output generated by
# powerplant_TableS4_full_rebuild.R. No facility-level values are entered by
# hand. Panel (a) is calculated from the same coal, gas, and oil data displayed
# in panel (b).
# ==============================================================================

rm(list = ls(all.names = TRUE))
graphics.off()

# ------------------------------------------------------------------------------
# 0. Packages
# ------------------------------------------------------------------------------

required_packages <- c(
  "dplyr",
  "tidyr",
  "ggplot2",
  "scales",
  "patchwork"
)

missing_packages <- required_packages[
  !vapply(
    required_packages,
    requireNamespace,
    logical(1),
    quietly = TRUE
  )
]

if (length(missing_packages) > 0L) {
  stop(
    "Missing required R packages: ",
    paste(missing_packages, collapse = ", "),
    "\nInstall them before running this script."
  )
}

suppressPackageStartupMessages({
  library(dplyr)
  library(tidyr)
  library(ggplot2)
  library(scales)
})

# ------------------------------------------------------------------------------
# 1. User paths
# ------------------------------------------------------------------------------

PROJECT_ROOT <- paste0(
  "/Users/xshan2/Library/CloudStorage/",
  "OneDrive-GeorgeMasonUniversity-O365Production/",
  "GMU_PhD/01_Research/03_powerplant"
)

MODEL_OUTPUT_DIR <- file.path(
  PROJECT_ROOT,
  "data",
  "TableS4_full_rebuild"
)

HISTORICAL_FUEL_FILE <- file.path(
  MODEL_OUTPUT_DIR,
  "historical_year_fuel_summary_CF095.csv"
)

OUTPUT_DIR <- file.path(
  PROJECT_ROOT,
  "Figure_plot"
)

dir.create(
  OUTPUT_DIR,
  recursive = TRUE,
  showWarnings = FALSE
)

if (!file.exists(HISTORICAL_FUEL_FILE)) {
  stop(
    "Cannot find the corrected historical output:\n",
    HISTORICAL_FUEL_FILE,
    "\nRun powerplant_TableS4_full_rebuild.R first."
  )
}

message("Historical input: ", HISTORICAL_FUEL_FILE)
message("Figure output:    ", OUTPUT_DIR)

# ------------------------------------------------------------------------------
# 2. Constants and plotting styles
# ------------------------------------------------------------------------------

TARGET_YEARS <- seq(1940L, 1990L, by = 10L)
FOSSIL_FUELS <- c("Coal", "Gas", "Oil")

KG_PER_SHORT_TON <- 907.18474
KG_PER_THOUSAND_SHORT_TONS <- KG_PER_SHORT_TON * 1000
TG_TO_THOUSAND_SHORT_TONS <- 1e9 / KG_PER_THOUSAND_SHORT_TONS

SERIES_LEVELS <- c(
  "EPA inventory",
  "Facility-level estimate",
  "AP-42 benchmark"
)

SERIES_COLORS <- c(
  "EPA inventory"           = "#000000",
  "Facility-level estimate" = "#0072B2",
  "AP-42 benchmark"         = "#D55E00"
)

SERIES_LINETYPES <- c(
  "EPA inventory"           = "solid",
  "Facility-level estimate" = "longdash",
  "AP-42 benchmark"         = "dotted"
)

SERIES_SHAPES <- c(
  "EPA inventory"           = 16,
  "Facility-level estimate" = 17,
  "AP-42 benchmark"         = 15
)

theme_publication <- function(base_size = 10) {
  theme_classic(
    base_size = base_size,
    base_family = "sans"
  ) +
    theme(
      text = element_text(color = "black"),
      axis.title = element_text(
        size = base_size,
        color = "black"
      ),
      axis.text = element_text(
        size = base_size - 1,
        color = "black"
      ),
      axis.ticks = element_line(
        color = "black",
        linewidth = 0.35
      ),
      axis.ticks.length = grid::unit(0.15, "cm"),
      panel.border = element_rect(
        color = "black",
        fill = NA,
        linewidth = 0.45
      ),
      panel.grid.major.y = element_line(
        color = "grey88",
        linewidth = 0.30
      ),
      panel.grid.major.x = element_blank(),
      panel.grid.minor = element_blank(),
      strip.background = element_rect(
        fill = "grey95",
        color = "black",
        linewidth = 0.40
      ),
      strip.text = element_text(
        size = base_size,
        face = "bold",
        color = "black",
        margin = margin(
          t = 4,
          r = 4,
          b = 4,
          l = 4
        )
      ),
      legend.position = "top",
      legend.direction = "horizontal",
      legend.title = element_blank(),
      legend.text = element_text(
        size = base_size - 1
      ),
      legend.key.width = grid::unit(1.5, "cm"),
      legend.key.height = grid::unit(0.45, "cm"),
      legend.margin = margin(
        t = 0,
        r = 0,
        b = 4,
        l = 0
      ),
      legend.box.margin = margin(0, 0, 0, 0),
      panel.spacing = grid::unit(0.70, "lines"),
      plot.margin = margin(
        t = 5,
        r = 6,
        b = 5,
        l = 5
      )
    )
}

# ------------------------------------------------------------------------------
# 3. Read final corrected facility-level historical output
# ------------------------------------------------------------------------------

historical_fuel_raw <- read.csv(
  HISTORICAL_FUEL_FILE,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

required_historical_columns <- c(
  "Year",
  "convert_fuel",
  "annual_gen_kWh",
  "SO2_tons",
  "NOx_tons"
)

missing_historical_columns <- setdiff(
  required_historical_columns,
  names(historical_fuel_raw)
)

if (length(missing_historical_columns) > 0L) {
  stop(
    "Missing columns in historical output: ",
    paste(missing_historical_columns, collapse = ", ")
  )
}

facility_fuel_final <- historical_fuel_raw %>%
  transmute(
    year = as.integer(Year),
    fuel = trimws(as.character(convert_fuel)),
    annual_gen_kWh = as.numeric(annual_gen_kWh),
    SO2_tons = as.numeric(SO2_tons),
    NOx_tons = as.numeric(NOx_tons)
  ) %>%
  filter(
    year %in% TARGET_YEARS,
    fuel %in% FOSSIL_FUELS
  ) %>%
  group_by(year, fuel) %>%
  summarise(
    annual_gen_kWh = sum(annual_gen_kWh, na.rm = TRUE),
    SO2_tons = sum(SO2_tons, na.rm = TRUE),
    NOx_tons = sum(NOx_tons, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  complete(
    year = TARGET_YEARS,
    fuel = FOSSIL_FUELS,
    fill = list(
      annual_gen_kWh = 0,
      SO2_tons = 0,
      NOx_tons = 0
    )
  ) %>%
  arrange(year, match(fuel, FOSSIL_FUELS))

if (nrow(facility_fuel_final) !=
    length(TARGET_YEARS) * length(FOSSIL_FUELS)) {
  stop("Unexpected number of year-by-fuel facility records.")
}

if (anyNA(facility_fuel_final)) {
  stop("Missing values remain in the facility year-by-fuel table.")
}

if (
  any(facility_fuel_final$SO2_tons < 0) ||
    any(facility_fuel_final$NOx_tons < 0) ||
    any(facility_fuel_final$annual_gen_kWh < 0)
) {
  stop("Negative facility activity or emissions were found.")
}

facility_total_final <- facility_fuel_final %>%
  group_by(year) %>%
  summarise(
    annual_gen_kWh = sum(annual_gen_kWh),
    SO2_tons = sum(SO2_tons),
    NOx_tons = sum(NOx_tons),
    .groups = "drop"
  ) %>%
  arrange(year)

if (!identical(
  as.integer(facility_total_final$year),
  as.integer(TARGET_YEARS)
)) {
  stop("Facility totals do not contain all target years in order.")
}

# ------------------------------------------------------------------------------
# 4. AP-42 benchmark using exact target-year activity
# ------------------------------------------------------------------------------

BTU_TO_J <- 1055.05585262
TBTU_TO_GJ <- (1e12 * BTU_TO_J) / 1e9
SHORT_TON_TO_METRIC_TON <- 0.90718474
GJ_PER_BBL_RESIDUAL_OIL <- 6.287
GJ_PER_SCF_GAS <- 0.001055
GJ_PER_MMBTU <- 1.05505585262
LB_TO_KG <- 0.45359237

ef_lb_per_mmbtu_to_kg_per_gj <- function(lb_per_mmbtu) {
  (lb_per_mmbtu * LB_TO_KG) / GJ_PER_MMBTU
}

ef_so2_from_sulfur <- function(
  sulfur_mass_fraction,
  hhv_gj_per_metric_ton
) {
  (2000 * sulfur_mass_fraction) / hhv_gj_per_metric_ton
}

# Baseline AP-42 assumptions retained from the analysis.
coal_hhv_gj_per_metric_ton <- c(
  `1940` = 26,
  `1950` = 26,
  `1960` = 26,
  `1970` = 25,
  `1980` = 24,
  `1990` = 24
)

so2_sulfur_fraction <- c(
  Coal = 0.020,
  Gas = 0.0002,
  Oil = 0.020
)

nox_lb_per_mmbtu <- c(
  Coal = 0.50,
  Gas = 0.15,
  Oil = 0.35
)

# Historical Statistics of the United States, Series S 95-107.
# Only the 1940 observation is required for the target-year comparison.
activity_1940 <- tibble(
  year = 1940L,
  Coal =
    51474 *
    1000 *
    SHORT_TON_TO_METRIC_TON *
    coal_hhv_gj_per_metric_ton[["1940"]],
  Oil =
    16825 *
    1000 *
    GJ_PER_BBL_RESIDUAL_OIL,
  Gas =
    180096 *
    1e6 *
    GJ_PER_SCF_GAS
)

# EIA Annual Energy Review 2011, Table 8.4a.
# Values are trillion Btu for the labeled target years.
activity_1950_1990_tbtu <- tribble(
  ~year, ~Coal, ~Gas, ~Oil,
  1950L,  2199,  651,  472,
  1960L,  4228, 1785,  553,
  1970L,  7227, 4054, 2117,
  1980L, 12123, 3810, 2634,
  1990L, 16477, 3791, 1366
)

activity_1950_1990 <- activity_1950_1990_tbtu %>%
  mutate(
    across(
      c(Coal, Gas, Oil),
      ~ .x * TBTU_TO_GJ
    )
  )

ap42_activity_target_year <- bind_rows(
  activity_1940,
  activity_1950_1990
) %>%
  select(year, Coal, Gas, Oil) %>%
  arrange(year)

if (!identical(
  as.integer(ap42_activity_target_year$year),
  as.integer(TARGET_YEARS)
)) {
  stop("AP-42 activity does not contain all target years in order.")
}

if (anyNA(ap42_activity_target_year)) {
  stop("Missing values were found in the AP-42 activity table.")
}

ap42_ef <- expand_grid(
  year = TARGET_YEARS,
  fuel = FOSSIL_FUELS
) %>%
  mutate(
    hhv_gj_per_metric_ton = case_when(
      fuel == "Coal" ~
        as.numeric(
          coal_hhv_gj_per_metric_ton[as.character(year)]
        ),
      fuel == "Gas" ~ 50,
      fuel == "Oil" ~ 42,
      TRUE ~ NA_real_
    ),
    EF_SO2_kg_per_GJ = ef_so2_from_sulfur(
      so2_sulfur_fraction[fuel],
      hhv_gj_per_metric_ton
    ),
    EF_NOx_kg_per_GJ = ef_lb_per_mmbtu_to_kg_per_gj(
      nox_lb_per_mmbtu[fuel]
    )
  )

ap42_by_fuel <- ap42_activity_target_year %>%
  pivot_longer(
    cols = all_of(FOSSIL_FUELS),
    names_to = "fuel",
    values_to = "activity_GJ"
  ) %>%
  left_join(
    ap42_ef,
    by = c("year", "fuel")
  ) %>%
  transmute(
    year,
    fuel,
    SO2_kst =
      activity_GJ *
      EF_SO2_kg_per_GJ /
      KG_PER_THOUSAND_SHORT_TONS,
    NOx_kst =
      activity_GJ *
      EF_NOx_kg_per_GJ /
      KG_PER_THOUSAND_SHORT_TONS
  ) %>%
  arrange(year, match(fuel, FOSSIL_FUELS))

if (
  nrow(ap42_by_fuel) !=
    length(TARGET_YEARS) * length(FOSSIL_FUELS)
) {
  stop("Unexpected number of AP-42 year-by-fuel records.")
}

if (anyNA(ap42_by_fuel)) {
  stop("Missing values were found in the AP-42 estimates.")
}

ap42_totals <- ap42_by_fuel %>%
  group_by(year) %>%
  summarise(
    SO2_kst = sum(SO2_kst),
    NOx_kst = sum(NOx_kst),
    .groups = "drop"
  ) %>%
  arrange(year)

# ------------------------------------------------------------------------------
# 5. EPA national inventory values
# ------------------------------------------------------------------------------

# Original units: Tg/year.
epa_nox_tg <- c(
  0.6,
  1.2,
  2.3,
  4.4,
  6.4,
  7.3
)

epa_so2_tg <- c(
  2.2,
  4.1,
  8.4,
  15.8,
  15.5,
  14.2
)

if (
  length(epa_nox_tg) != length(TARGET_YEARS) ||
    length(epa_so2_tg) != length(TARGET_YEARS)
) {
  stop("EPA vectors must contain one value for every target year.")
}

# ------------------------------------------------------------------------------
# 6. Assemble panel (a): national totals
# ------------------------------------------------------------------------------

figure1a_data <- bind_rows(
  tibble(
    year = TARGET_YEARS,
    pollutant = "NO[x]",
    series = "EPA inventory",
    emissions_kst =
      epa_nox_tg *
      TG_TO_THOUSAND_SHORT_TONS
  ),
  tibble(
    year = TARGET_YEARS,
    pollutant = "SO[2]",
    series = "EPA inventory",
    emissions_kst =
      epa_so2_tg *
      TG_TO_THOUSAND_SHORT_TONS
  ),
  facility_total_final %>%
    transmute(
      year,
      pollutant = "NO[x]",
      series = "Facility-level estimate",
      emissions_kst = NOx_tons / 1000
    ),
  facility_total_final %>%
    transmute(
      year,
      pollutant = "SO[2]",
      series = "Facility-level estimate",
      emissions_kst = SO2_tons / 1000
    ),
  ap42_totals %>%
    transmute(
      year,
      pollutant = "NO[x]",
      series = "AP-42 benchmark",
      emissions_kst = NOx_kst
    ),
  ap42_totals %>%
    transmute(
      year,
      pollutant = "SO[2]",
      series = "AP-42 benchmark",
      emissions_kst = SO2_kst
    )
) %>%
  mutate(
    year = as.integer(year),
    pollutant = factor(
      pollutant,
      levels = c("NO[x]", "SO[2]")
    ),
    series = factor(
      series,
      levels = SERIES_LEVELS
    )
  ) %>%
  arrange(pollutant, series, year)

if (nrow(figure1a_data) != 36L) {
  stop("Panel (a) must contain 36 records.")
}

if (anyNA(figure1a_data)) {
  stop("Missing values remain in panel (a) plotting data.")
}

if (any(figure1a_data$emissions_kst < 0)) {
  stop("Negative emissions were found in panel (a).")
}

# ------------------------------------------------------------------------------
# 7. Assemble panel (b): fuel-specific estimates
# ------------------------------------------------------------------------------

facility_fuel_long <- facility_fuel_final %>%
  select(
    year,
    fuel,
    SO2_tons,
    NOx_tons
  ) %>%
  pivot_longer(
    cols = c(SO2_tons, NOx_tons),
    names_to = "pollutant",
    values_to = "emissions_tons"
  ) %>%
  transmute(
    year,
    fuel,
    pollutant = recode(
      pollutant,
      "NOx_tons" = "NO[x]",
      "SO2_tons" = "SO[2]"
    ),
    series = "Facility-level estimate",
    emissions_kst = emissions_tons / 1000
  )

ap42_fuel_long <- ap42_by_fuel %>%
  pivot_longer(
    cols = c(SO2_kst, NOx_kst),
    names_to = "pollutant",
    values_to = "emissions_kst"
  ) %>%
  transmute(
    year,
    fuel,
    pollutant = recode(
      pollutant,
      "NOx_kst" = "NO[x]",
      "SO2_kst" = "SO[2]"
    ),
    series = "AP-42 benchmark",
    emissions_kst
  )

figure1b_data <- bind_rows(
  facility_fuel_long,
  ap42_fuel_long
) %>%
  mutate(
    year = as.integer(year),
    pollutant = factor(
      pollutant,
      levels = c("NO[x]", "SO[2]")
    ),
    fuel = factor(
      fuel,
      levels = FOSSIL_FUELS
    ),
    series = factor(
      series,
      levels = SERIES_LEVELS
    )
  ) %>%
  arrange(pollutant, fuel, series, year)

if (nrow(figure1b_data) != 72L) {
  stop("Panel (b) must contain 72 records.")
}

if (anyNA(figure1b_data)) {
  stop("Missing values remain in panel (b) plotting data.")
}

if (any(figure1b_data$emissions_kst < 0)) {
  stop("Negative emissions were found in panel (b).")
}

# ------------------------------------------------------------------------------
# 8. Cross-panel QA
# ------------------------------------------------------------------------------

cross_panel_check <- figure1b_data %>%
  group_by(year, pollutant, series) %>%
  summarise(
    fuel_sum_kst = sum(emissions_kst),
    .groups = "drop"
  ) %>%
  left_join(
    figure1a_data %>%
      select(
        year,
        pollutant,
        series,
        national_emissions_kst = emissions_kst
      ),
    by = c(
      "year",
      "pollutant",
      "series"
    )
  ) %>%
  mutate(
    absolute_difference_kst =
      fuel_sum_kst -
      national_emissions_kst
  )

if (anyNA(cross_panel_check$national_emissions_kst)) {
  stop("Panel (a) and panel (b) could not be matched.")
}

if (
  max(
    abs(cross_panel_check$absolute_difference_kst),
    na.rm = TRUE
  ) > 1e-8
) {
  stop(
    "Panel (a) does not equal the sum of the fuels in panel (b)."
  )
}

# National comparison table requested for Results and supplementary QA.
national_comparison <- figure1a_data %>%
  mutate(
    pollutant_text = recode(
      as.character(pollutant),
      "NO[x]" = "NOx",
      "SO[2]" = "SO2"
    ),
    series_text = as.character(series)
  ) %>%
  select(
    year,
    pollutant = pollutant_text,
    series = series_text,
    emissions_kst
  ) %>%
  pivot_wider(
    names_from = series,
    values_from = emissions_kst
  ) %>%
  transmute(
    year,
    pollutant,
    EPA_inventory_kst = .data[["EPA inventory"]],
    facility_estimate_kst =
      .data[["Facility-level estimate"]],
    AP42_benchmark_kst =
      .data[["AP-42 benchmark"]],
    facility_minus_EPA_kst =
      facility_estimate_kst -
      EPA_inventory_kst,
    facility_relative_difference_percent =
      100 *
      facility_minus_EPA_kst /
      EPA_inventory_kst,
    AP42_minus_EPA_kst =
      AP42_benchmark_kst -
      EPA_inventory_kst,
    AP42_relative_difference_percent =
      100 *
      AP42_minus_EPA_kst /
      EPA_inventory_kst
  ) %>%
  arrange(pollutant, year)

# ------------------------------------------------------------------------------
# 9. Draw panel (a)
# ------------------------------------------------------------------------------

figure1a <- ggplot(
  figure1a_data,
  aes(
    x = year,
    y = emissions_kst,
    color = series,
    linetype = series,
    shape = series,
    group = series
  )
) +
  geom_line(
    linewidth = 0.85
  ) +
  geom_point(
    size = 2.3,
    stroke = 0.4
  ) +
  facet_wrap(
    ~pollutant,
    nrow = 1,
    scales = "free_y",
    labeller = label_parsed
  ) +
  scale_color_manual(
    values = SERIES_COLORS,
    breaks = SERIES_LEVELS,
    drop = FALSE
  ) +
  scale_linetype_manual(
    values = SERIES_LINETYPES,
    breaks = SERIES_LEVELS,
    drop = FALSE
  ) +
  scale_shape_manual(
    values = SERIES_SHAPES,
    breaks = SERIES_LEVELS,
    drop = FALSE
  ) +
  scale_x_continuous(
    breaks = TARGET_YEARS,
    limits = c(1938, 1992),
    expand = expansion(mult = c(0, 0))
  ) +
  scale_y_continuous(
    labels = label_comma(accuracy = 1),
    expand = expansion(mult = c(0.02, 0.07))
  ) +
  labs(
    x = "Year",
    y = expression(
      "Emissions (" * 10^3 * " short tons)"
    )
  ) +
  guides(
    color = guide_legend(
      nrow = 1,
      byrow = TRUE
    ),
    linetype = guide_legend(
      nrow = 1,
      byrow = TRUE
    ),
    shape = guide_legend(
      nrow = 1,
      byrow = TRUE
    )
  ) +
  theme_publication(base_size = 10)

# ------------------------------------------------------------------------------
# 10. Draw panel (b)
# ------------------------------------------------------------------------------

figure1b <- ggplot(
  figure1b_data,
  aes(
    x = year,
    y = emissions_kst,
    color = series,
    linetype = series,
    shape = series,
    group = series
  )
) +
  geom_line(
    linewidth = 0.80
  ) +
  geom_point(
    size = 2,
    stroke = 0.4
  ) +
  facet_grid(
    pollutant ~ fuel,
    scales = "free_y",
    labeller = labeller(
      pollutant = label_parsed,
      fuel = label_value
    )
  ) +
  scale_color_manual(
    values = SERIES_COLORS,
    breaks = c(
      "Facility-level estimate",
      "AP-42 benchmark"
    ),
    drop = TRUE
  ) +
  scale_linetype_manual(
    values = SERIES_LINETYPES,
    breaks = c(
      "Facility-level estimate",
      "AP-42 benchmark"
    ),
    drop = TRUE
  ) +
  scale_shape_manual(
    values = SERIES_SHAPES,
    breaks = c(
      "Facility-level estimate",
      "AP-42 benchmark"
    ),
    drop = TRUE
  ) +
  scale_x_continuous(
    breaks = TARGET_YEARS,
    limits = c(1938, 1992),
    expand = expansion(mult = c(0, 0))
  ) +
  scale_y_continuous(
    labels = label_comma(accuracy = 1),
    expand = expansion(mult = c(0.02, 0.08))
  ) +
  labs(
    x = "Year",
    y = expression(
      "Emissions (" * 10^3 * " short tons)"
    )
  ) +
  theme_publication(base_size = 9) +
  theme(
    legend.position = "none",
    panel.spacing.x = grid::unit(
      0.65,
      "lines"
    ),
    panel.spacing.y = grid::unit(
      0.60,
      "lines"
    ),
    axis.text.x = element_text(
      size = 7.5
    )
  )

# ------------------------------------------------------------------------------
# 11. Combine panels
# ------------------------------------------------------------------------------

figure1_combined <- patchwork::wrap_plots(
  figure1a,
  figure1b,
  ncol = 1,
  heights = c(0.78, 1.22)
) +
  patchwork::plot_annotation(
    tag_levels = "a",
    tag_prefix = "(",
    tag_suffix = ")",
    theme = theme(
      plot.tag = element_text(
        family = "sans",
        face = "bold",
        size = 11,
        color = "black"
      ),
      plot.tag.position = c(
        0.002,
        0.998
      ),
      plot.margin = margin(
        t = 5,
        r = 5,
        b = 5,
        l = 5
      )
    )
  )

print(figure1_combined)

