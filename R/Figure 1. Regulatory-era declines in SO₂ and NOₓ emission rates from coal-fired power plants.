# ==============================================================================
# 1. Read and validate inputs
# ==============================================================================

holdout <- read.csv(
  holdout_file,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

campd <- read.csv(
  campd_file,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

required_holdout <- c(
  "pollutant",
  "facility_id",
  "Year",
  "observed_EF_g_per_kWh",
  "predicted_EF_g_per_kWh"
)

missing_holdout <- setdiff(required_holdout, names(holdout))

if (length(missing_holdout) > 0L) {
  stop(
    "Holdout file is missing column(s): ",
    paste(missing_holdout, collapse = ", ")
  )
}

standardize_pollutant <- function(x) {
  x <- toupper(trimws(as.character(x)))
  ifelse(x == "NOX", "NOx", ifelse(x == "SO2", "SO2", x))
}

normalize_name <- function(x) {
  tolower(gsub("[^a-z0-9]", "", x))
}

pick_column <- function(column_names, candidates, label) {
  hit <- match(normalize_name(candidates), normalize_name(column_names))
  hit <- hit[!is.na(hit)]
  if (length(hit) == 0L) {
    stop(
      "Could not identify ", label, " in CAMPD file. Available columns: ",
      paste(column_names, collapse = ", ")
    )
  }
  column_names[hit[1L]]
}

holdout <- holdout %>%
  transmute(
    pollutant = standardize_pollutant(pollutant),
    facility_id = as.character(facility_id),
    Year = as.integer(Year),
    observed_EF_g_per_kWh = as.numeric(observed_EF_g_per_kWh),
    predicted_EF_g_per_kWh = as.numeric(predicted_EF_g_per_kWh)
  ) %>%
  filter(
    pollutant %in% c("SO2", "NOx"),
    is.finite(observed_EF_g_per_kWh),
    is.finite(predicted_EF_g_per_kWh),
    observed_EF_g_per_kWh >= 0,
    predicted_EF_g_per_kWh >= 0
  )

if (nrow(holdout) == 0L) {
  stop("No usable independent-holdout predictions were found.")
}

campd_facility_column <- pick_column(
  names(campd),
  c("Facility.ID", "Facility ID", "facility_id", "ORISPL_CODE"),
  "facility identifier"
)

campd_year_column <- pick_column(
  names(campd),
  c("Year", "year"),
  "year"
)

campd_generation_column <- pick_column(
  names(campd),
  c("Gross.Load..MWh.", "Gross Load (MWh)", "Gross.Load.MWh"),
  "gross generation"
)

campd_key <- campd %>%
  transmute(
    facility_id = as.character(.data[[campd_facility_column]]),
    Year = as.integer(.data[[campd_year_column]]),
    gross_generation_kWh =
      as.numeric(.data[[campd_generation_column]]) * 1000
  )

duplicate_campd_keys <- campd_key %>%
  count(facility_id, Year, name = "n") %>%
  filter(n > 1)

if (nrow(duplicate_campd_keys) > 0L) {
  stop("CAMPD facility file contains duplicate facility-year records.")
}

grams_per_short_ton <- 907184.74

modern <- holdout %>%
  inner_join(campd_key, by = c("facility_id", "Year")) %>%
  mutate(
    observed_emissions_short_tons =
      observed_EF_g_per_kWh * gross_generation_kWh /
      grams_per_short_ton,
    predicted_emissions_short_tons =
      predicted_EF_g_per_kWh * gross_generation_kWh /
      grams_per_short_ton
  ) %>%
  filter(
    Year >= 1997,
    Year <= 2020,
    is.finite(gross_generation_kWh),
    gross_generation_kWh > 0,
    is.finite(observed_emissions_short_tons),
    is.finite(predicted_emissions_short_tons)
  )

if (nrow(modern) == 0L) {
  stop(
    "No holdout predictions matched the CAMPD facility-year data for 1997-2020."
  )
}

# ==============================================================================
# 2. Independent-holdout metrics
# ==============================================================================

calculate_metrics <- function(observed, predicted) {
  keep <- is.finite(observed) & is.finite(predicted)
  observed <- observed[keep]
  predicted <- predicted[keep]

  if (length(observed) < 2L) {
    stop("At least two observations are required to calculate metrics.")
  }

  ss_total <- sum((observed - mean(observed))^2)
  observed_sum <- sum(observed)

  data.frame(
    n = length(observed),
    predictive_R2 = if (ss_total > 0) {
      1 - sum((predicted - observed)^2) / ss_total
    } else {
      NA_real_
    },
    NME = if (observed_sum > 0) {
      sum(abs(predicted - observed)) / observed_sum
    } else {
      NA_real_
    },
    NMB = if (observed_sum > 0) {
      sum(predicted - observed) / observed_sum
    } else {
      NA_real_
    },
    MAE_g_per_kWh = mean(abs(predicted - observed)),
    RMSE_g_per_kWh = sqrt(mean((predicted - observed)^2)),
    mean_bias_g_per_kWh = mean(predicted - observed)
  )
}

holdout_metrics <- holdout %>%
  group_by(pollutant) %>%
  group_modify(
    ~calculate_metrics(
      .x$observed_EF_g_per_kWh,
      .x$predicted_EF_g_per_kWh
    )
  ) %>%
  ungroup()

metric_labels <- holdout_metrics %>%
  mutate(
    label = paste0(
      "R² = ", sprintf("%.3f", predictive_R2),
      "\nNME = ", sprintf("%.1f%%", 100 * NME),
      "\nNMB = ", sprintf("%+.1f%%", 100 * NMB)
    )
  )

# ==============================================================================
# 3. Annual observed and reconstructed emissions
# ==============================================================================

annual_emissions <- modern %>%
  group_by(pollutant, Year) %>%
  summarise(
    observed_emissions_short_tons = sum(
      observed_emissions_short_tons,
      na.rm = TRUE
    ),
    predicted_emissions_short_tons = sum(
      predicted_emissions_short_tons,
      na.rm = TRUE
    ),
    observed_generation_weighted_EF_g_per_kWh =
      weighted.mean(
        observed_EF_g_per_kWh,
        gross_generation_kWh,
        na.rm = TRUE
      ),
    predicted_generation_weighted_EF_g_per_kWh =
      weighted.mean(
        predicted_EF_g_per_kWh,
        gross_generation_kWh,
        na.rm = TRUE
      ),
    n_facilities = n_distinct(facility_id),
    .groups = "drop"
  )

annual_long <- annual_emissions %>%
  select(
    pollutant,
    Year,
    CAMPD = observed_emissions_short_tons,
    XGBoost = predicted_emissions_short_tons
  ) %>%
  pivot_longer(
    cols = c(CAMPD, XGBoost),
    names_to = "series",
    values_to = "emissions_short_tons"
  ) %>%
  mutate(
    series = factor(series, levels = c("CAMPD", "XGBoost")),
    emissions_million_short_tons = emissions_short_tons / 1e6
  )

