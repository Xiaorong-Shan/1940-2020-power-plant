panel_a <- make_holdout_panel("SO2")
panel_b <- make_holdout_panel("NOx")
panel_c <- make_annual_panel("SO2")
panel_d <- make_annual_panel("NOx")

extract_legend <- function(plot_object) {
  plot_grob <- ggplotGrob(plot_object)
  guide_positions <- grep("^guide-box", plot_grob$layout$name)

  for (position in guide_positions) {
    candidate <- plot_grob$grobs[[position]]
    if (!inherits(candidate, "zeroGrob")) {
      return(candidate)
    }
  }

  stop("Could not extract the annual-series legend.")
}

common_legend <- extract_legend(panel_d)

# The two annual panels share one legend below the complete figure.
panel_c <- panel_c +
  theme(
    legend.position = "none",
    aspect.ratio = 1
  )
panel_d <- panel_d +
  theme(
    legend.position = "none",
    aspect.ratio = 1
  )

# Convert to grobs and impose identical left/right dimensions. This keeps the
# panel boundaries, axis titles, and panel tags aligned despite different label
# widths in the scatter and annual-emissions rows.
panel_grobs <- list(
  ggplotGrob(panel_a),
  ggplotGrob(panel_b),
  ggplotGrob(panel_c),
  ggplotGrob(panel_d)
)

common_widths <- do.call(
  grid::unit.pmax,
  lapply(panel_grobs, function(x) x$widths)
)

top_heights <- grid::unit.pmax(
  panel_grobs[[1]]$heights,
  panel_grobs[[2]]$heights
)

bottom_heights <- grid::unit.pmax(
  panel_grobs[[3]]$heights,
  panel_grobs[[4]]$heights
)

for (i in seq_along(panel_grobs)) {
  panel_grobs[[i]]$widths <- common_widths
}

panel_grobs[[1]]$heights <- top_heights
panel_grobs[[2]]$heights <- top_heights
panel_grobs[[3]]$heights <- bottom_heights
panel_grobs[[4]]$heights <- bottom_heights

# Use only the base-R grid package to arrange panels. No patchwork, cowplot,
# or gridExtra installation is required on Hopper.
draw_figure1 <- function() {
  grid::grid.newpage()
  layout <- grid::grid.layout(
    nrow = 3,
    ncol = 2,
    widths = grid::unit(c(1, 1), "null"),
    heights = grid::unit(c(1, 1, 0.11), "null")
  )
  grid::pushViewport(grid::viewport(layout = layout))

  draw_panel <- function(grob, row, column, tag) {
    grid::pushViewport(
      grid::viewport(layout.pos.row = row, layout.pos.col = column)
    )
    grid::grid.draw(grob)
    grid::grid.text(
      label = tag,
      x = grid::unit(0.015, "npc"),
      y = grid::unit(0.995, "npc"),
      just = c("left", "top"),
      gp = grid::gpar(
        fontfamily = "sans",
        fontface = "plain",
        fontsize = 10,
        col = "black"
      )
    )
    grid::popViewport()
  }

  draw_panel(panel_grobs[[1]], 1, 1, "(a)")
  draw_panel(panel_grobs[[2]], 1, 2, "(b)")
  draw_panel(panel_grobs[[3]], 2, 1, "(c)")
  draw_panel(panel_grobs[[4]], 2, 2, "(d)")

  grid::pushViewport(
    grid::viewport(layout.pos.row = 3, layout.pos.col = 1:2)
  )
  grid::grid.draw(common_legend)
  grid::popViewport()

  grid::popViewport()
}

draw_figure1()

