# ==============================================================================
# 5. Plot helpers
# ==============================================================================

observed_color <- "black"
predicted_color <- "#3B6FB6"

theme_publication <- function(base_size = 10) {
  theme_classic(base_size = base_size, base_family = "sans") +
    theme(
      text = element_text(color = "black"),
      axis.title = element_text(size = base_size, color = "black"),
      axis.text = element_text(size = base_size - 1, color = "black"),
      axis.ticks = element_line(color = "black", linewidth = 0.35),
      axis.ticks.length = grid::unit(0.15, "cm"),
      panel.border = element_rect(
        color = "black",
        fill = NA,
        linewidth = 0.45
      ),
      panel.grid.major = element_line(color = "grey90", linewidth = 0.3),
      panel.grid.minor = element_blank(),
      legend.title = element_blank(),
      legend.text = element_text(size = base_size - 1),
      legend.key.width = grid::unit(1.3, "cm"),
      plot.margin = margin(5, 6, 5, 5)
    )
}

pollutant_expression <- function(pollutant) {
  if (pollutant == "SO2") expression(SO[2]) else expression(NO[x])
}

make_holdout_panel <- function(pollutant_name) {
  plot_data <- holdout %>%
    filter(pollutant == pollutant_name)

  label_data <- metric_labels %>%
    filter(pollutant == pollutant_name)

  upper_limit <- max(
    c(
      plot_data$observed_EF_g_per_kWh,
      plot_data$predicted_EF_g_per_kWh
    ),
    na.rm = TRUE
  )

  ggplot(
    plot_data,
    aes(
      x = observed_EF_g_per_kWh,
      y = predicted_EF_g_per_kWh
    )
  ) +
    geom_abline(
      intercept = 0,
      slope = 1,
      color = "grey35",
      linewidth = 0.65,
      linetype = "dashed"
    ) +
    geom_point(
      color = predicted_color,
      alpha = 0.18,
      size = 0.85
    ) +
    annotate(
      "label",
      x = 0.04 * upper_limit,
      y = 0.96 * upper_limit,
      label = label_data$label,
      hjust = 0,
      vjust = 1,
      size = 3.0,
      label.size = 0.25,
      fill = alpha("white", 0.88)
    ) +
    coord_equal(
      xlim = c(0, upper_limit),
      ylim = c(0, upper_limit),
      expand = FALSE
    ) +
    scale_x_continuous(labels = label_number(accuracy = 0.1)) +
    scale_y_continuous(labels = label_number(accuracy = 0.1)) +
    labs(
      title = pollutant_expression(pollutant_name),
      x = expression("Observed emission factor (g kWh"^{-1} * ")"),
      y = expression("Predicted emission factor (g kWh"^{-1} * ")")
    ) +
    theme_publication(base_size = 10) +
    theme(
      plot.title = element_text(
        hjust = 0.5,
        face = "bold",
        size = 10
      )
    )
}

make_annual_panel <- function(pollutant_name) {
  plot_data <- annual_long %>%
    filter(pollutant == pollutant_name)

  ggplot(
    plot_data,
    aes(
      x = Year,
      y = emissions_million_short_tons,
      color = series,
      linetype = series,
      shape = series,
      group = series
    )
  ) +
    geom_line(linewidth = 0.9) +
    geom_point(size = 1.7) +
    scale_color_manual(
      values = c(
        "CAMPD" = observed_color,
        "XGBoost" = predicted_color
      )
    ) +
    scale_linetype_manual(
      values = c(
        "CAMPD" = "solid",
        "XGBoost" = "dashed"
      )
    ) +
    scale_shape_manual(
      values = c(
        "CAMPD" = 16,
        "XGBoost" = 17
      )
    ) +
    scale_x_continuous(
      breaks = seq(2000, 2020, by = 5),
      limits = c(1996.5, 2020.5),
      expand = expansion(mult = c(0, 0))
    ) +
    scale_y_continuous(
      labels = label_number(accuracy = 0.1, trim = TRUE),
      limits = c(0, NA),
      expand = expansion(mult = c(0, 0.07))
    ) +
    labs(
      title = pollutant_expression(pollutant_name),
      x = "Year",
      y = expression("Annual emissions (million short tons yr"^{-1} * ")")
    ) +
    theme_publication(base_size = 10) +
    theme(
      plot.title = element_text(
        hjust = 0.5,
        face = "bold",
        size = 10
      ),
      legend.position = "bottom",
      legend.direction = "horizontal"
    )
}

