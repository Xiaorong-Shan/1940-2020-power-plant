# ======================================================================
# 3. SUMMARY HELPERS
# ======================================================================

# Ratio of sums calculated only from rows with a valid numerator-denominator
# pair. This retains the national aggregate definition used in the original
# figure while avoiding unmatched numerator and denominator totals.
ratio_of_sums <- function(numerator, denominator) {
  valid <- (
    is.finite(numerator) &
      numerator >= 0 &
      is.finite(denominator) &
      denominator > 0
  )

  if (!any(valid)) {
    return(NA_real_)
  }

  sum(numerator[valid]) / sum(denominator[valid])
}


# Weighted empirical quantile. Generation weights are used for g/kWh and
# heat-input weights are used for lb/MMBtu so the variability bands use the
# same activity basis as their corresponding national aggregate.
weighted_quantile_safe <- function(x, w, probability) {
  valid <- (
    is.finite(x) &
      x >= 0 &
      is.finite(w) &
      w > 0
  )

  x <- x[valid]
  w <- w[valid]

  if (length(x) == 0 || sum(w) <= 0) {
    return(NA_real_)
  }

  ordering <- order(x)
  x <- x[ordering]
  w <- w[ordering]
  cumulative_weight <- cumsum(w) / sum(w)

  x[which(cumulative_weight >= probability)[1]]
}


# ======================================================================
