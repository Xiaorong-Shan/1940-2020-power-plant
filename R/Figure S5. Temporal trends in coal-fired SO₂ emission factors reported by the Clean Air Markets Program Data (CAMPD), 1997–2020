  breaks = c(1997, 2000, 2005, 2010, 2015, 2020),
  limits = c(1997, 2020),
  expand = expansion(mult = c(0.01, 0.02))
)

zero_based_y_scale <- function() {
  scale_y_continuous(
    limits = c(0, NA),
    breaks = scales::pretty_breaks(n = 6),
    expand = expansion(mult = c(0, 0.06))
  )
}

theme_figure_s5 <- theme_bw(base_size = 10.5) +
