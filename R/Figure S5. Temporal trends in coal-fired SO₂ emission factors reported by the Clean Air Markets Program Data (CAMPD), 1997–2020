national_annual <- coal %>%
  group_by(year) %>%
  summarise(
    n_facilities = n_distinct(facility_id),
    aggregate_so2_g_kwh = ratio_of_sums(
      so2_grams,
      generation_kwh
    ),
    facility_q25_so2_g_kwh = weighted_quantile_safe(
      so2_g_kwh,
      generation_kwh,
      0.25
    ),
    facility_q75_so2_g_kwh = weighted_quantile_safe(
      so2_g_kwh,
      generation_kwh,
      0.75
    ),
    aggregate_so2_lb_mmbtu = ratio_of_sums(
      so2_lb,
      heat_input_mmbtu
    ),
    facility_q25_so2_lb_mmbtu = weighted_quantile_safe(
      so2_lb_mmbtu,
      heat_input_mmbtu,
      0.25
    ),
    facility_q75_so2_lb_mmbtu = weighted_quantile_safe(
      so2_lb_mmbtu,
      heat_input_mmbtu,
      0.75
    ),
    .groups = "drop"
  ) %>%
  arrange(year)

control_levels <- c(
  "No unit reported control",
  "At least one unit reported control"
)

control_annual <- coal %>%
  filter(binary_control_group %in% control_levels) %>%
  group_by(year, binary_control_group) %>%
  summarise(
    n_facilities = n_distinct(facility_id),
    aggregate_so2_g_kwh = ratio_of_sums(
      so2_grams,
      generation_kwh
    ),
    facility_q25_so2_g_kwh = weighted_quantile_safe(
      so2_g_kwh,
      generation_kwh,
      0.25
    ),
    facility_q75_so2_g_kwh = weighted_quantile_safe(
      so2_g_kwh,
      generation_kwh,
      0.75
    ),
    .groups = "drop"
  ) %>%
  mutate(
    binary_control_group = factor(
      binary_control_group,
      levels = control_levels
    )
  ) %>%
  arrange(binary_control_group, year)

expected_years <- 1997:2020
missing_national_years <- setdiff(expected_years, national_annual$year)

if (length(missing_national_years) > 0) {
  warning(
    "National summary is missing year(s): ",
