      population_columns
    ),
    with = FALSE
  ],
  id.vars = c(
    "STATEFP",
    "COUNTYFP"
  ),
  variable.name = "population_field",
  value.name = "population"
)

population_long[
  ,
  year := as.integer(
    sub(
      "^A00AA",
      "",
      population_field
    )
  )
]

population_long[
  ,
  `:=`(
    statefp_numeric = suppressWarnings(
      as.integer(
        trimws(
          as.character(STATEFP)
        )
      )
    ),
    countyfp_numeric = suppressWarnings(
      as.integer(
        trimws(
          as.character(COUNTYFP)
        )
      )
    )
  )
]

population_long[
  ,
  geoid := data.table::fifelse(
    !is.na(statefp_numeric) &
      data.table::between(
        statefp_numeric,
        1L,
        99L
      ) &
      !is.na(countyfp_numeric) &
      data.table::between(
        countyfp_numeric,
        1L,
        999L
      ),
    sprintf(
      "%02d%03d",
      statefp_numeric,
      countyfp_numeric
    ),
    NA_character_
  )
]

population_long[
  ,
  `:=`(
    geoid = fmt_geoid5(geoid),
    population = as.numeric(population)
  )
]

population_rows_before_filter <- nrow(
  population_long[
    year %in% YEARS
  ]
)

population_dt <- population_long[
  year %in% YEARS &
    !is.na(geoid) &
    geoid %in% counties_sf$geoid,
  .(
    geoid,
    year,
    population
  )
]

population_rows_excluded <- (
  population_rows_before_filter -
    nrow(population_dt)
)

# Remove only byte-for-byte duplicate observations. Conflicting population
# values for the same valid CONUS county-year remain visible to the check below.
population_dt <- unique(
  population_dt,
  by = c(
    "geoid",
    "year",
    "population"
  )
)

duplicate_population <- population_dt[
  ,
  .N,
  by = .(
    geoid,
    year
  )
][N > 1L]

if (nrow(duplicate_population) > 0L) {
  stop(
    "Population file has conflicting duplicate valid CONUS county-year rows. ",
    "First duplicated keys: ",
    paste(
      head(
        paste0(
          duplicate_population$geoid,
          "-",
          duplicate_population$year
        ),
        10L
      ),
      collapse = ", "
    )
  )
}

