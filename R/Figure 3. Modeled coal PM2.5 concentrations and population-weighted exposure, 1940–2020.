make_map_panel <- function(
    map_data,
    state_data,
    years,
    scale_info,
    panel_title,
    legend_title,
    facet_rows,
    map_colors
) {
  plot_data <- map_data[
    as.integer(
      as.character(
        map_data$year
      )
    ) %in% years,
  ]

  plot_data$year <- factor(
    as.integer(
      as.character(
        plot_data$year
      )
    ),
    levels = years,
    labels = years
  )

  ggplot() +
    geom_sf(
      data = plot_data,
      aes(
        fill = pm25
      ),
      color = NA,
      linewidth = 0
    ) +
    geom_sf(
      data = state_data,
      inherit.aes = FALSE,
      fill = NA,
      color = "grey55",
