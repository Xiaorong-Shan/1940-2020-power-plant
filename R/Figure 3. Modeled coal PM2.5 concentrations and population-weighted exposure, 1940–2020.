fmt_geoid5 <- function(x) {
  raw_x <- trimws(as.character(x))
  numeric_x <- suppressWarnings(
    as.integer(raw_x)
  )

  valid_x <- grepl(
    "^[0-9]{1,5}$",
    raw_x
  ) &
    !is.na(numeric_x) &
    numeric_x >= 0L &
    numeric_x <= 99999L

  result <- rep(
    NA_character_,
    length(raw_x)
  )

  result[valid_x] <- sprintf(
    "%05d",
    numeric_x[valid_x]
  )

  result
}

rename_case_insensitive <- function(dt, target, alternatives = target) {
  if (target %in% names(dt)) {
    return(invisible(dt))
  }

  name_lower <- tolower(names(dt))
  positions <- match(
    tolower(alternatives),
    name_lower,
    nomatch = 0L
  )
  positions <- positions[positions > 0L]

  if (length(positions) > 0L) {
    data.table::setnames(
      dt,
      names(dt)[positions[1L]],
      target
    )
  }

  invisible(dt)
}

resolve_pm25_file <- function(year) {
  if (year %in% HISTORICAL_YEARS) {
    return(file.path(
      BASE_DIR,
      sprintf("grids_pm25_total_%d.fst", year)
    ))
  }

  file.path(
    MODERN_DIR,
    sprintf("grids_pm25_byunit_%d.fst", year)
  )
}

derive_total_grid <- function(fst_path, year) {
  dt <- as.data.table(
    fst::read_fst(fst_path)
  )

  rename_case_insensitive(
    dt,
    "x",
    c("x", "xcoord", "x_coord", "easting")
  )

  rename_case_insensitive(
    dt,
    "y",
    c("y", "ycoord", "y_coord", "northing")
  )

  if (!all(c("x", "y") %in% names(dt))) {
    stop(
      "The PM2.5 file for ", year,
      " does not contain x and y coordinates. Columns are: ",
      paste(names(dt), collapse = ", ")
    )
  }

  dt[, `:=`(
    x = as.numeric(x),
    y = as.numeric(y)
  )]

  # Total-grid schema used by the historical files.
  preferred_total <- c(
    "vals.out",
    "vals_out",
    "total",
    "total_pm25",
    "pm25_total"
  )

  preferred_match <- preferred_total[
    tolower(preferred_total) %in% tolower(names(dt))
  ]

  if (length(preferred_match) > 0L) {
    actual_name <- names(dt)[
      match(
        tolower(preferred_match[1L]),
        tolower(names(dt))
      )
    ]

    total_dt <- dt[
      ,
      .(
        vals.out = sum(
          as.numeric(get(actual_name)),
          na.rm = TRUE
        )
      ),
      by = .(x, y)
    ]

    source_schema <- paste0(
      "existing_total_column:",
      actual_name
    )

  } else {
    uid_candidates <- c(
      "uid",
      "unit_id",
      "unitid",
      "plant_id",
      "plantid",
      "source_id",
      "sourceid"
    )

    uid_name <- names(dt)[
      tolower(names(dt)) %in% uid_candidates
    ]

    numeric_columns <- names(dt)[
      vapply(
        dt,
        is.numeric,
        logical(1)
      )
    ]

    metadata_columns <- names(dt)[
      tolower(names(dt)) %in% c(
        "x", "y", "year", "month",
        "e", "emiss", "emissions",
        "so2", "hyads", "rowid",
        "cell", "cell_id", "cellid"
      )
    ]

    value_columns <- setdiff(
      numeric_columns,
      c(
        metadata_columns,
        uid_name
      )
    )

    if (length(uid_name) > 0L) {
      # Long schema: x, y, uID, and one PM2.5 value column.
      preferred_value_names <- c(
        "pm25",
        "value",
        "prediction",
        "pred",
        "concentration",
        "conc"
      )

      preferred_value <- value_columns[
        tolower(value_columns) %in% preferred_value_names
      ]

      if (length(preferred_value) == 1L) {
        value_column <- preferred_value
      } else if (length(value_columns) == 1L) {
        value_column <- value_columns
      } else {
        stop(
          "Cannot identify one PM2.5 value column in the long by-unit ",
          "file for ", year, ". Candidate numeric columns are: ",
          paste(value_columns, collapse = ", ")
        )
      }

      total_dt <- dt[
        ,
        .(
          vals.out = sum(
            as.numeric(get(value_column)),
            na.rm = TRUE
          )
        ),
        by = .(x, y)
      ]

      source_schema <- paste0(
        "long_byunit:",
        value_column
      )

    } else {
      # Wide schema: x, y, and one numeric column per generating unit.
      if (length(value_columns) == 0L) {
        stop(
          "No numeric unit-level PM2.5 columns were found for ",
          year, ". Columns are: ",
          paste(names(dt), collapse = ", ")
        )
      }

      dt[
        ,
        vals.out := rowSums(
          .SD,
          na.rm = TRUE
        ),
        .SDcols = value_columns
      ]

      total_dt <- dt[
        ,
        .(
          vals.out = sum(
            vals.out,
            na.rm = TRUE
          )
        ),
        by = .(x, y)
      ]

      source_schema <- paste0(
        "wide_byunit:",
        length(value_columns),
        "_unit_columns"
      )
    }
  }

  total_dt <- total_dt[
    is.finite(x) &
      is.finite(y) &
      is.finite(vals.out)
  ]

  if (nrow(total_dt) == 0L) {
    stop(
      "No finite grid cells remained after reading ",
      fst_path
    )
  }

  data.table::setorder(
    total_dt,
    y,
    x
  )

  attr(total_dt, "source_schema") <- source_schema
  total_dt
}

make_raster_albers <- function(total_dt) {
  r <- raster::rasterFromXYZ(
    total_dt[, .(x, y, vals.out)]
  )
  raster::crs(r) <- P4S
  r
}

area_weighted_mean_by_polygon <- function(r, polygons_sf) {
  polygons_sp <- methods::as(
    polygons_sf,
    "Spatial"
  )

  extracted <- raster::extract(
    r,
    polygons_sp,
    weights = TRUE,
    na.rm = TRUE
  )

  result <- vapply(
    extracted,
    function(x) {
      if (is.null(x)) {
        return(NA_real_)
      }

      if (is.data.frame(x) || is.matrix(x)) {
        if (nrow(x) == 0L) {
          return(NA_real_)
        }

        values <- as.numeric(x[, 1L])
        weight_names <- c(
          "weight",
          "weights",
          "w",
          "wt",
          "frac",
          "fraction"
        )

        weight_column <- weight_names[
          weight_names %in% colnames(x)
        ][1L]

        if (!is.na(weight_column)) {
          weights <- as.numeric(
            x[, weight_column]
          )

          valid <- is.finite(values) &
            is.finite(weights) &
            weights > 0

          if (any(valid)) {
            return(stats::weighted.mean(
              values[valid],
              weights[valid]
            ))
          }
        }

        if (ncol(x) >= 2L) {
          weights <- as.numeric(x[, 2L])
          valid <- is.finite(values) &
            is.finite(weights) &
            weights > 0

          if (
            any(valid) &&
              max(weights[valid], na.rm = TRUE) <= 1.0001
          ) {
            return(stats::weighted.mean(
              values[valid],
              weights[valid]
            ))
          }
        }

        finite_values <- values[
          is.finite(values)
        ]

        if (length(finite_values) == 0L) {
          return(NA_real_)
        }

        return(mean(finite_values))
      }

      if (is.numeric(x)) {
        finite_values <- x[
          is.finite(x)
        ]

        if (length(finite_values) == 0L) {
          return(NA_real_)
        }

        return(mean(finite_values))
      }

      NA_real_
    },
    numeric(1)
  )

  as.numeric(result)
}

project_and_repair_polygons <- function(polygons_sf, label) {
  # Older sf installations call lwgeom from st_make_valid(). Hopper does not
  # have lwgeom, so project first and use the GEOS zero-width-buffer fallback
  # only when invalid polygon geometries are actually present.
  polygons_sf <- sf::st_transform(
    polygons_sf,
    crs = P4S
  )

  valid_before <- sf::st_is_valid(polygons_sf)
  invalid_before <- is.na(valid_before) |
    !valid_before
  n_invalid_before <- sum(invalid_before)

  if (n_invalid_before > 0L) {
    polygons_sf <- suppressWarnings(
      sf::st_buffer(
        polygons_sf,
        dist = 0
      )
    )
  }

  valid_after <- sf::st_is_valid(polygons_sf)
  invalid_after <- is.na(valid_after) |
    !valid_after
  n_invalid_after <- sum(invalid_after)

  if (n_invalid_after > 0L) {
    stop(
      label,
      " geometry repair failed for ",
      n_invalid_after,
      " feature(s). Install the R package 'lwgeom' only if this ",
      "fallback is insufficient."
    )
  }

  cat(
    label,
    " geometry check: ",
    n_invalid_before,
    " invalid before repair; ",
    n_invalid_after,
    " invalid after repair.\n",
    sep = ""
  )

  polygons_sf
}

derive_nice_scale <- function(values, probability = 0.99) {
  values <- as.numeric(values)
  values <- values[
    is.finite(values) &
      values >= 0
  ]

  if (length(values) == 0L) {
    stop(
      "Cannot derive a color scale from an empty value vector."
    )
  }

  raw_cap <- as.numeric(
    stats::quantile(
      values,
      probs = probability,
      na.rm = TRUE,
      names = FALSE
    )
  )

  if (!is.finite(raw_cap) || raw_cap <= 0) {
    raw_cap <- max(
      values,
      na.rm = TRUE
    )
  }

  if (!is.finite(raw_cap) || raw_cap <= 0) {
    stop(
      "Cannot derive a positive color-scale maximum."
    )
  }

  candidate_breaks <- pretty(
    c(
      0,
      raw_cap
    ),
    n = 4
  )

  candidate_breaks <- candidate_breaks[
    candidate_breaks >= 0
  ]

  cap <- max(
    candidate_breaks
  )

  breaks <- candidate_breaks[
    candidate_breaks <= cap
  ]

  if (length(breaks) > 6L) {
    breaks <- seq(
      0,
      cap,
      length.out = 5L
    )
  }

  accuracy <- if (cap < 0.1) {
    0.01
  } else if (cap < 1) {
    0.05
  } else {
    0.1
  }

  display_breaks <- round(
    breaks / accuracy
  ) * accuracy

  decimal_places <- max(
    0L,
    ceiling(
      -log10(
        accuracy
      )
    )
  )

  label_text <- formatC(
    display_breaks,
    format = "f",
    digits = decimal_places
  )

  # Plotmath reliably renders the final legend label as "greater than or
  # equal to" on Hopper, whereas a literal Unicode symbol may become dots.
  label_expression_text <- label_text
  label_expression_text[
    length(
      label_expression_text
    )
  ] <- paste0(
    "phantom(0) >= ",
    label_text[
      length(
        label_text
      )
    ]
  )

  labels <- parse(
    text = label_expression_text
  )

  list(
    cap = cap,
    breaks = breaks,
    labels = labels,
    quantile_value = raw_cap
  )
}

