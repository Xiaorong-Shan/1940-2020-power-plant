# ==============================================================================
# 5. Grid totals, county aggregation, and national PWE
# ==============================================================================

county_results <- vector(
  "list",
  length(YEARS)
)

national_results <- vector(
  "list",
  length(YEARS)
)

qa_results <- vector(
  "list",
  length(YEARS)
)

county_attributes <- sf::st_drop_geometry(
  counties_sf
)

for (year_index in seq_along(YEARS)) {
  year <- YEARS[year_index]
  current_year <- year
  input_file <- input_files[year_index]

  cat(
    "\n========== Processing ",
    year,
    " ==========\n",
    sep = ""
  )
  cat(
    "Input: ",
    input_file,
    "\n",
    sep = ""
  )

  total_grid <- derive_total_grid(
    input_file,
    year
  )

  source_schema <- attr(
    total_grid,
    "source_schema"
  )

  if (year %in% MODERN_YEARS) {
    derived_file <- file.path(
      DERIVED_TOTAL_DIR,
      sprintf(
        "grids_pm25_total_%d.fst",
        year
      )
    )

    fst::write_fst(
      total_grid,
      derived_file,
      compress = 50
    )

    cat(
      "Derived modern total: ",
      derived_file,
      "\n",
      sep = ""
    )
  }

  grid_raster <- make_raster_albers(
    total_grid
  )

  raster_min <- raster::cellStats(
    grid_raster,
    stat = "min",
    na.rm = TRUE
  )

  raster_max <- raster::cellStats(
    grid_raster,
    stat = "max",
    na.rm = TRUE
  )

  cat(
    "Grid schema: ",
    source_schema,
    "\n",
    sep = ""
  )

  cat(
    "Grid cells: ",
    nrow(total_grid),
    " | min/max: ",
    signif(raster_min, 6),
    " / ",
    signif(raster_max, 6),
    "\n",
    sep = ""
  )

  cat(
    "Extracting area-weighted county means...\n"
  )

  county_pm25 <- area_weighted_mean_by_polygon(
    grid_raster,
    counties_sf
  )

  county_year <- data.table(
    geoid = fmt_geoid5(
      county_attributes$geoid
    ),
    state_abbr = as.character(
      county_attributes$state_abbr
    ),
    state_name = as.character(
      county_attributes$state_name
    ),
    county_name = as.character(
      county_attributes$name
    ),
    year = year,
    pm25 = as.numeric(
      county_pm25
    )
  )

  county_year <- merge(
    county_year,
    population_dt[
      year == current_year
    ],
    by = c(
      "geoid",
      "year"
    ),
    all.x = TRUE,
    sort = FALSE
  )

  valid_for_pwe <- county_year[
    is.finite(pm25) &
      is.finite(population) &
      population > 0
  ]

  if (nrow(valid_for_pwe) == 0L) {
    stop(
      "No valid county population and PM2.5 rows for ",
      year
    )
  }

  national_population <- valid_for_pwe[
    ,
    sum(
      population,
      na.rm = TRUE
    )
  ]

  national_pwe <- valid_for_pwe[
    ,
    sum(
      pm25 * population,
      na.rm = TRUE
    ) / national_population
  ]

  county_year[
    ,
    `:=`(
      burden = fifelse(
        is.finite(pm25) &
          is.finite(population) &
          population > 0,
        pm25 * population,
        NA_real_
      ),
      contribution_to_national_pwe = fifelse(
        is.finite(pm25) &
          is.finite(population) &
          population > 0,
        pm25 * population /
          national_population,
        NA_real_
      )
    )
  ]

  population_all_conus <- population_dt[
    year == current_year &
      geoid %in% counties_sf$geoid &
      is.finite(population) &
      population > 0,
    sum(population)
  ]

  population_coverage <- if (
    is.finite(population_all_conus) &&
      population_all_conus > 0
  ) {
    national_population /
      population_all_conus
  } else {
    NA_real_
  }

  county_file <- file.path(
    TABLE_DIR,
    sprintf(
      "county_pm25_pop_%d.csv",
      year
    )
  )

  data.table::fwrite(
    county_year,
    county_file
  )

  county_results[[year_index]] <- county_year

  national_results[[year_index]] <- data.table(
    year = year,
    PWE = national_pwe,
    population_used = national_population,
    population_coverage_fraction = population_coverage,
    n_counties_used = nrow(valid_for_pwe)
  )

  qa_results[[year_index]] <- data.table(
    year = year,
    input_file = input_file,
    source_schema = source_schema,
    n_grid_cells = nrow(total_grid),
    grid_min_pm25 = raster_min,
    grid_max_pm25 = raster_max,
    n_counties_total = nrow(county_year),
    n_counties_with_pm25 = county_year[
      is.finite(pm25),
      .N
    ],
    n_counties_used_for_pwe = nrow(valid_for_pwe),
    county_pm25_missing_fraction = mean(
      !is.finite(county_year$pm25)
    ),
    population_coverage_fraction = population_coverage,
    national_PWE = national_pwe
  )

  cat(
    "Counties used for PWE: ",
    nrow(valid_for_pwe),
    " | population coverage: ",
    sprintf(
      "%.3f%%",
      100 * population_coverage
    ),
    "\n",
    sep = ""
  )

  cat(
    "National PWE: ",
    signif(
      national_pwe,
      8
    ),
    " ug/m3\n",
    sep = ""
  )

  rm(
    total_grid,
    grid_raster,
    county_pm25,
    valid_for_pwe
  )
  gc()
}

