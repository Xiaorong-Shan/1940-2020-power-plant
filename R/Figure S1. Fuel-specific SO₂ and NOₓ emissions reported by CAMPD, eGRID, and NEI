safe_r_squared <- function(x, y) {
  keep <- is.finite(x) & is.finite(y)
  x <- x[keep]
  y <- y[keep]

  if (length(x) < 2 || sd(x) == 0 || sd(y) == 0) {
    return(NA_real_)
  }

  cor(x, y)^2
}

agreement_metrics <- s1_comparison %>%
  group_by(panel, comparison) %>%
  summarise(
    n_years = n(),
    first_year = min(year),
    last_year = max(year),
    r_squared = safe_r_squared(campd_Mt, comparison_Mt),
    median_relative_difference_pct = {
      differences <- if_else(
        campd_Mt > 0,
        100 * (comparison_Mt - campd_Mt) / campd_Mt,
        NA_real_
      )
      if (all(is.na(differences))) {
        NA_real_
      } else {
        median(differences, na.rm = TRUE)
      }
    },
    .groups = "drop"
  ) %>%
  mutate(
    metric_label = if_else(
      is.finite(r_squared) & is.finite(median_relative_difference_pct),
      sprintf(
        "%s: n = %d, R\u00B2 = %.2f, median \u0394 = %+.0f%%",
        comparison,
        n_years,
        r_squared,
        median_relative_difference_pct
      ),
      sprintf("%s: n = %d", comparison, n_years)
    ),
    label_row = if_else(comparison == "eGRID", 1L, 2L)
  )

stage_write_csv(
  agreement_metrics,
