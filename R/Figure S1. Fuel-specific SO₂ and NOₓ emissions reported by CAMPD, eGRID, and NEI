# ------------------------------
# Safe output helpers
# ------------------------------

# OneDrive CloudStorage can time out when R writes compressed or high-resolution
# files directly into the synced project folder. All outputs are therefore
# completed in this temporary staging folder first. They are copied to the
# original project folders only after the data preparation and plotting finish.
# The staging folder is not the final output location.
STAGE_ROOT <- file.path(path.expand("~"), "powerplant_s1_write_stage")
dir.create(STAGE_ROOT, recursive = TRUE, showWarnings = FALSE)

if (!dir.exists(STAGE_ROOT)) {
  stop("Could not create the local write-staging directory: ", STAGE_ROOT)
}

PUBLISH_QUEUE <- list()

staged_path <- function(final_path) {
  stage_dir <- file.path(STAGE_ROOT, basename(dirname(final_path)))
  dir.create(stage_dir, recursive = TRUE, showWarnings = FALSE)
  file.path(stage_dir, basename(final_path))
}

register_output <- function(stage_path, final_path) {
  PUBLISH_QUEUE[[length(PUBLISH_QUEUE) + 1L]] <<- list(
    stage_path = stage_path,
    final_path = final_path
  )
  invisible(stage_path)
}

stage_write_csv <- function(data, final_path) {
  stage_path <- staged_path(final_path)
  readr::write_csv(data, stage_path)
  register_output(stage_path, final_path)
}

stage_save_rds <- function(object, final_path) {
  stage_path <- staged_path(final_path)
  saveRDS(object, stage_path)
  register_output(stage_path, final_path)
}

stage_ggsave <- function(final_path, plot, ...) {
  stage_path <- staged_path(final_path)
  ggplot2::ggsave(
    filename = stage_path,
    plot = plot,
    ...
  )
  register_output(stage_path, final_path)
}

same_file_size <- function(first_path, second_path) {
  tryCatch({
    if (!file.exists(first_path) || !file.exists(second_path)) return(FALSE)

    first_size <- file.info(first_path)$size
    second_size <- file.info(second_path)$size

    is.finite(first_size) &&
      is.finite(second_size) &&
      first_size > 0 &&
      identical(as.numeric(first_size), as.numeric(second_size))
  }, error = function(e) FALSE)
}

publish_project_outputs <- function(queue, retries = 2L, wait_seconds = 3) {
  results <- vector("list", length(queue))

  for (i in seq_along(queue)) {
    stage_path <- queue[[i]]$stage_path
    final_path <- queue[[i]]$final_path
    dir.create(dirname(final_path), recursive = TRUE, showWarnings = FALSE)

    copied <- FALSE
    for (attempt in seq_len(retries)) {
      copied_now <- tryCatch(
        suppressWarnings(
          file.copy(
            from = stage_path,
            to = final_path,
            overwrite = TRUE,
            copy.mode = FALSE,
            copy.date = FALSE
          )
        ),
        error = function(e) FALSE
      )

      copied <- isTRUE(copied_now) && same_file_size(stage_path, final_path)
      if (copied) break
      if (attempt < retries) Sys.sleep(wait_seconds)
    }

    results[[i]] <- tibble(
      stage_path = stage_path,
      final_path = final_path,
      copied = copied
    )

    if (copied) {
      unlink(stage_path)
    } else {
      warning(
        "OneDrive did not accept this file after ", retries,
        " attempts. The completed local copy was retained at:\n",
        stage_path,
        "\nIntended project path:\n",
        final_path,
        call. = FALSE
      )
    }
  }

  bind_rows(results)
}

