clean_names_simple <- function(data) {
  cleaned <- iconv(names(data), to = "ASCII//TRANSLIT")
  cleaned[is.na(cleaned)] <- names(data)[is.na(cleaned)]
  cleaned <- tolower(cleaned)
  cleaned <- gsub("[^a-z0-9]+", "_", cleaned)
  cleaned <- gsub("^_+|_+$", "", cleaned)
  cleaned[cleaned == ""] <- "x"
  names(data) <- make.unique(cleaned, sep = "_")
  data
}

to_numeric_clean <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c("", "NA", "N/A", "na", "n/a", "--", ".")] <- NA_character_
  x <- gsub(",", "", x, fixed = TRUE)
  suppressWarnings(as.numeric(x))
}

first_matching_column <- function(column_names, patterns, required = TRUE) {
  for (pattern in patterns) {
    hit <- column_names[str_detect(column_names, regex(pattern, ignore_case = TRUE))]
    if (length(hit) > 0) return(hit[1])
  }
  if (required) {
    stop("No column matched: ", paste(patterns, collapse = " | "))
  }
  NA_character_
}

map_fuel_group <- function(x) {
  raw <- trimws(as.character(x))
  lower <- tolower(raw)
  code <- toupper(gsub("[^A-Z0-9]", "", raw))

  coal_codes <- c(
    "ANT", "BIT", "LIG", "SUB", "WC", "RC", "SC", "COL", "COAL"
  )
  gas_codes <- c(
    "NG", "BFG", "COG", "OG", "PG", "SG", "SNG", "GAS"
  )
  oil_codes <- c(
    "DFO", "RFO", "JF", "KER", "WO", "PC", "PET", "OIL"
  )
  biomass_codes <- c(
    "AB", "BLQ", "LFG", "MSW", "OBG", "OBS", "WDL", "WDS", "BIO"
  )

  case_when(
    code %in% coal_codes |
      str_detect(
        lower,
        "coal|anthracite|bituminous|subbituminous|lignite|coal refuse"
      ) ~ "Coal",
    code %in% gas_codes |
      str_detect(
        lower,
        "natural gas|blast furnace gas|coke oven gas|gaseous"
      ) ~ "Gas",
    code %in% oil_codes |
      str_detect(code, "^FO[0-9]+$") |
      str_detect(
        lower,
        "oil|petroleum|diesel|distillate|residual|kerosene|jet fuel"
      ) ~ "Oil",
    code %in% biomass_codes |
      str_detect(
        lower,
        "biomass|wood|black liquor|landfill gas|municipal solid waste"
      ) ~ "Biomass",
    TRUE ~ "Other"
  )
}

