#!/usr/bin/env Rscript

# ================================================================
# Figure 4: monitor-level comparison of modeled coal PM2.5
# against observed sulfate in 1980 and 1990
#
# This script uses the previously matched monitor-level CSV files.
# It does not read the original AQS or HyADS input files and does
# not require Cairo graphics.
# ================================================================

rm(list = ls(all.names = TRUE))
graphics.off()

suppressPackageStartupMessages({
  library(data.table)
  library(ggplot2)
  library(grid)
  library(gridExtra)
})

# ------------------------------
# 0. Settings
# ------------------------------

PROJECT_DIR <- "/scratch/xshan2/R_Code/disperseR/main"

MODEL_DIR <- file.path(
  PROJECT_DIR,
  "output",
  "pm25_decades_model.lm.cv_single_poly_proxy1999met"
)

FIGURE_DIR <- file.path(
  MODEL_DIR,
  "evaluation",
  "aqs_hyads_eval_figure4"
)

FIGURE_WIDTH_IN <- 7.4
FIGURE_HEIGHT_IN <- 3.8
FIGURE_DPI <- 600

MATCHED_FILES <- list(
  `1980` = file.path(
    FIGURE_DIR,
    "Figure4_matched_monitor_data_1980.csv"
  ),
  `1990` = file.path(
    FIGURE_DIR,
    "Figure4_matched_monitor_data_1990.csv"
  )
)

OUTPUT_PDF <- file.path(
  FIGURE_DIR,
  "Figure4_AQS_sulfate_plainpdf_20260916.pdf"
)

OUTPUT_PNG <- file.path(
  FIGURE_DIR,
  "Figure4_AQS_sulfate_plainpdf_20260916.png"
)

OUTPUT_STATS <- file.path(
  FIGURE_DIR,
  "Figure4_AQS_sulfate_statistics_20260916.csv"
)

dir.create(FIGURE_DIR, recursive = TRUE, showWarnings = FALSE)

missing_files <- unlist(MATCHED_FILES)[
  !file.exists(unlist(MATCHED_FILES))
]

if (length(missing_files) > 0L) {
  stop(
    "Missing matched-monitor files:\n",
    paste(missing_files, collapse = "\n")
  )
}

message("Reading matched data from: ", FIGURE_DIR)

# ------------------------------
# 1. Read matched monitor data
# ------------------------------

read_matched_data <- function(file_path, analysis_year) {
  dt <- data.table::fread(file_path)

  required_columns <- c("observed", "modeled")
  missing_columns <- setdiff(required_columns, names(dt))

  if (length(missing_columns) > 0L) {
    stop(
      basename(file_path),
      " is missing required columns: ",
      paste(missing_columns, collapse = ", ")
    )
  }

  dt[, observed := as.numeric(observed)]
  dt[, modeled := as.numeric(modeled)]
  dt <- dt[is.finite(observed) & is.finite(modeled)]

  if (nrow(dt) < 3L) {
    stop(
      "Fewer than three valid matched monitors were found for ",
      analysis_year,
      "."
    )
  }

  dt[, year := as.integer(analysis_year)]
  dt
}

matched_data <- list(
  `1980` = read_matched_data(MATCHED_FILES[["1980"]], 1980L),
  `1990` = read_matched_data(MATCHED_FILES[["1990"]], 1990L)
)

message("1980 matched monitors: ", nrow(matched_data[["1980"]]))
message("1990 matched monitors: ", nrow(matched_data[["1990"]]))

# ------------------------------
# 2. Calculate validation statistics
# ------------------------------

calculate_metrics <- function(observed, modeled) {
  valid <- is.finite(observed) & is.finite(modeled)
  observed <- observed[valid]
  modeled <- modeled[valid]

  if (length(observed) < 3L) {
    stop("Fewer than three valid observed-modeled pairs.")
  }

  pearson_r <- suppressWarnings(
    stats::cor(observed, modeled, method = "pearson")
  )

  spearman_rho <- suppressWarnings(
    stats::cor(observed, modeled, method = "spearman")
  )

  list(
    n = length(observed),
    mean_observed = mean(observed),
    mean_modeled = mean(modeled),
    mean_bias = mean(modeled - observed),
    mae = mean(abs(modeled - observed)),
    rmse = sqrt(mean((modeled - observed)^2)),
    pearson_r = pearson_r,
    spearman_rho = spearman_rho,
    r2 = pearson_r^2
  )
}

statistics_by_year <- data.table::rbindlist(
  lapply(names(matched_data), function(year_text) {
    dt <- matched_data[[year_text]]
    metrics <- calculate_metrics(dt$observed, dt$modeled)

    data.table::data.table(
      year = as.integer(year_text),
      n = metrics$n,
      mean_observed = metrics$mean_observed,
      mean_modeled = metrics$mean_modeled,
      mean_bias = metrics$mean_bias,
      mae = metrics$mae,
      rmse = metrics$rmse,
      pearson_r = metrics$pearson_r,
      spearman_rho = metrics$spearman_rho,
      r2 = metrics$r2
    )
  })
)

data.table::setorder(statistics_by_year, year)
data.table::fwrite(statistics_by_year, OUTPUT_STATS)
print(statistics_by_year)

# ------------------------------
# 3. Create each panel
# ------------------------------

make_panel <- function(plot_data, year_label, panel_label) {
  metrics <- calculate_metrics(plot_data$observed, plot_data$modeled)

  # "rho" is written in ASCII to avoid the two-dot rendering problem.
  annotation_text <- sprintf(
    "n = %d\nPearson r = %.2f\nSpearman rho = %.2f\nR\u00B2 = %.2f",
    metrics$n,
    metrics$pearson_r,
    metrics$spearman_rho,
    metrics$r2
  )

  ggplot2::ggplot(
    plot_data,
    ggplot2::aes(x = observed, y = modeled)
  ) +
    ggplot2::geom_point(
      color = "black",
      alpha = 0.45,
      size = 1.3
    ) +
    ggplot2::geom_smooth(
      method = "lm",
      formula = y ~ x,
      se = FALSE,
      color = "#3568D4",
      size = 0.9
    ) +
    ggplot2::annotate(
      "text",
      x = Inf,
      y = Inf,
      label = annotation_text,
      hjust = 1.05,
      vjust = 1.12,
      size = 3.2,
      lineheight = 0.95
    ) +
    ggplot2::scale_x_continuous(
      expand = ggplot2::expansion(mult = c(0.02, 0.04))
    ) +
    ggplot2::scale_y_continuous(
      expand = ggplot2::expansion(mult = c(0.03, 0.06))
    ) +
    ggplot2::labs(
      tag = panel_label,
      title = year_label,
      x = expression(
        "Annual mean observed sulfate (" * mu * "g " * m^{-3} * ")"
      ),
      y = expression(
        "Annual mean modeled coal PM"[2.5] *
          " (" * mu * "g " * m^{-3} * ")"
      )
    ) +
    ggplot2::theme_bw(base_size = 10, base_family = "sans") +
    ggplot2::theme(
      text = ggplot2::element_text(color = "black"),
      plot.title = ggplot2::element_text(
        size = 11,
        face = "bold",
        hjust = 0.5,
        margin = ggplot2::margin(b = 4)
      ),
      plot.tag = ggplot2::element_text(size = 11, face = "bold"),
      plot.tag.position = c(0.015, 0.985),
      axis.title = ggplot2::element_text(size = 9.5),
      axis.text = ggplot2::element_text(size = 8.5, color = "black"),
      axis.ticks = ggplot2::element_line(color = "black", size = 0.35),
      panel.grid.major = ggplot2::element_line(
        color = "grey88",
        size = 0.3
      ),
      panel.grid.minor = ggplot2::element_blank(),
      panel.border = ggplot2::element_rect(
        color = "grey35",
        fill = NA,
        size = 0.45
      ),
      plot.margin = ggplot2::margin(8, 8, 6, 8)
    )
}

panel_1980 <- make_panel(
  matched_data[["1980"]],
  year_label = "1980",
  panel_label = "(a)"
)

panel_1990 <- make_panel(
  matched_data[["1990"]],
  year_label = "1990",
  panel_label = "(b)"
)

combined_figure <- gridExtra::arrangeGrob(
  panel_1980,
  grid::nullGrob(),
  panel_1990,
  ncol = 3,
  widths = c(1, 0.05, 1)
)

# ------------------------------
# 4. Save with the standard PDF device
# ------------------------------

if (file.exists(OUTPUT_PDF)) {
  unlink(OUTPUT_PDF)
}

grDevices::pdf(
  file = OUTPUT_PDF,
  width = FIGURE_WIDTH_IN,
  height = FIGURE_HEIGHT_IN,
  onefile = TRUE,
  useDingbats = FALSE,
  paper = "special",
  bg = "white"
)

grid::grid.newpage()
grid::grid.draw(combined_figure)
invisible(grDevices::dev.off())

if (!file.exists(OUTPUT_PDF) || file.info(OUTPUT_PDF)$size <= 0L) {
  stop("The PDF file was not created successfully: ", OUTPUT_PDF)
}

message("PDF saved: ", normalizePath(OUTPUT_PDF))

# ------------------------------
# 5. Create PNG from the PDF when pdftoppm is available
# ------------------------------

png_created <- FALSE
pdftoppm_command <- Sys.which("pdftoppm")

if (nzchar(pdftoppm_command)) {
  png_prefix <- sub("\\.png$", "", OUTPUT_PNG)

  conversion_status <- system2(
    pdftoppm_command,
    args = c(
      "-png",
      "-r",
      as.character(FIGURE_DPI),
      "-singlefile",
      shQuote(OUTPUT_PDF),
      shQuote(png_prefix)
    )
  )

  png_created <- identical(conversion_status, 0L) &&
    file.exists(OUTPUT_PNG) &&
    file.info(OUTPUT_PNG)$size > 0L
}

if (png_created) {
  message("PNG saved: ", normalizePath(OUTPUT_PNG))
} else {
  message(
    "PNG was not created because pdftoppm is unavailable or conversion failed."
  )
}

message("Statistics saved: ", normalizePath(OUTPUT_STATS))
message("Figure 4 replot completed successfully.")
